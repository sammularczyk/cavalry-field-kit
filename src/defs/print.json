      "max": 1.0,
      "step": 0.01
    },
    "outputMode": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "amount": {
      "type": "double",
      "default": 1.0,
