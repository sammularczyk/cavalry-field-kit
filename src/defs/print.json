  "attributes": {
    "process": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2
      ]
    },
    "separation": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2,
        3
      ]
    },
    "inkCount": {
      "type": "int",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1,
      "dimming": "separation == 3"
    },
    "flatten": {
      "type": "double",
      "default": 1.5,
      "min": 0.0,
      "softMax": 8.0,
      "step": 0.1
    },
    "levels": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 8.0,
      "step": 1.0
    },
    "levelBias": {
      "type": "double",
      "default": 1.0,
      "min": 0.1,
      "softMax": 4.0,
      "step": 0.05,
      "dimming": "levels <= 0"
    },
    "bandDither": {
      "type": "double",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "levels <= 0"
    },
    "screenType": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2,
        3,
        4,
        5
      ]
    },
    "dotShape": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2,
        3
      ],
      "dimming": "screenType != 1"
    },
    "screenStrength": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "screenType == 0"
    },
    "inkGrain": {
      "type": "double",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "inkGrainScale": {
      "type": "double",
      "default": 0.35,
      "min": 0.05,
      "softMax": 6.0,
      "step": 0.05
    },
    "frequency": {
      "type": "double",
      "default": 8.0,
      "softMin": 1.0,
      "softMax": 64.0,
      "step": 0.1,
      "dimming": "screenType == 0"
    },
    "dotGain": {
      "type": "double",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "screenType == 0"
    },
    "toneFloor": {
      "type": "double",
      "default": 0.02,
      "min": 0.001,
      "max": 0.5,
      "step": 0.005,
      "dimming": "separation != 0"
    },
    "yuleNielsen": {
      "type": "double",
      "default": 1.7,
      "min": 1.0,
      "max": 4.0,
      "step": 0.05,
      "dimming": "separation == 3"
    },
    "ink1Color": {
      "type": "color",
      "default": {
        "type": "Color",
        "r": 0,
        "g": 90,
        "b": 181,
        "a": 255
      },
      "dimming": "separation == 3"
    },
    "ink1Angle": {
      "type": "double",
      "default": 15.0,
      "min": 0.0,
      "max": 180.0,
      "step": 1.0,
      "dimming": "separation == 3 || screenType == 0"
    },
    "ink1Coverage": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "dimming": "separation == 3"
    },
    "ink2Color": {
      "type": "color",
      "default": {
        "type": "Color",
        "r": 255,
        "g": 214,
        "b": 0,
        "a": 255
      },
      "dimming": "inkCount <= 1 || separation == 3"
    },
    "ink2Angle": {
      "type": "double",
      "default": 45.0,
      "min": 0.0,
      "max": 180.0,
      "step": 1.0,
      "dimming": "inkCount <= 1 || separation == 3 || screenType == 0"
    },
    "ink2Coverage": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "dimming": "inkCount <= 1 || separation == 3"
    },
    "ink3Color": {
      "type": "color",
      "default": {
        "type": "Color",
        "r": 226,
        "g": 61,
        "b": 130,
        "a": 255
      },
      "dimming": "inkCount <= 2 || separation == 3"
    },
    "ink3Angle": {
      "type": "double",
      "default": 75.0,
      "min": 0.0,
      "max": 180.0,
      "step": 1.0,
      "dimming": "inkCount <= 2 || separation == 3 || screenType == 0"
    },
    "ink3Coverage": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "dimming": "inkCount <= 2 || separation == 3"
    },
    "ink4Color": {
      "type": "color",
      "default": {
        "type": "Color",
        "r": 20,
        "g": 20,
        "b": 22,
        "a": 255
      },
      "dimming": "inkCount <= 3 || separation == 3"
    },
    "ink4Angle": {
      "type": "double",
      "default": 105.0,
      "min": 0.0,
      "max": 180.0,
      "step": 1.0,
      "dimming": "inkCount <= 3 || separation == 3 || screenType == 0"
    },
    "ink4Coverage": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.01,
      "dimming": "inkCount <= 3 || separation == 3"
    },
    "inkOpacity": {
      "type": "double",
      "default": 0.85,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "registrationError": {
      "type": "double",
      "default": 1.5,
      "min": 0.0,
      "softMax": 20.0,
      "step": 0.1
    },
    "edgeBreakup": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 6.0,
      "step": 0.1
    },
    "edgeBreakupScale": {
      "type": "double",
      "default": 1.0,
      "min": 0.05,
      "softMax": 6.0,
      "step": 0.05,
      "dimming": "edgeBreakup <= 0"
    },
    "keyline": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 6.0,
      "step": 0.1
    },
    "keylineThreshold": {
      "type": "double",
      "default": 0.12,
      "min": 0.01,
      "max": 1.0,
      "step": 0.01,
      "dimming": "keyline <= 0"
    },
    "inkLoss": {
      "type": "double",
      "default": 0.15,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "inkLossScale": {
      "type": "double",
      "default": 0.05,
      "min": 0.02,
      "softMax": 3.0,
      "step": 0.01,
      "dimming": "inkLoss <= 0"
    },
    "mottle": {
      "type": "double",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "ghosting": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "seed": {
      "type": "int",
      "default": 1,
      "min": 0
    },
    "boil": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 12.0,
      "step": 1.0
    },
    "time": {
      "type": "double",
      "default": 0.0,
      "step": 1.0,
      "compConnect": "time",
      "dimming": "boil <= 0"
    },
    "paperColor": {
      "type": "color",
      "default": {
        "type": "Color",
        "r": 247,
        "g": 243,
        "b": 233,
        "a": 255
      }
    },
    "paperGrain": {
      "type": "double",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "paperFolds": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "paperFoldCount": {
      "type": "double",
      "default": 5.0,
      "min": 1.0,
      "max": 15.0,
      "step": 1.0,
      "dimming": "paperFolds <= 0"
    },
    "paperCrumples": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "paperCrumpleSize": {
      "type": "double",
      "default": 0.35,
      "min": 0.01,
      "max": 1.0,
      "step": 0.01,
      "dimming": "paperCrumples <= 0"
    },
    "paperFibre": {
      "type": "double",
