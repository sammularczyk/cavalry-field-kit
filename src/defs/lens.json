          "---Inspired by Hawk-Anamorphic-Nuke (MIT), M. Blumen, hornet & F. Lorber"
        ]
      }
    ],
    "controls": {
      "displaceMap": "nodeInput",
      "defocusMap": "nodeInput"
    },
    "icon": "lens.png"
  }
}