{
  "author": "samMularczyk",
  "type": "lens",
  "superType": "thirdPartyFilter",
  "version": "1.0",
  "passes": [
    {
      "skslFile": "lensDistort.sksl",
      "uniforms": [
        "profile",
        "distortion",
        "squeeze",
        "centreOffset",
        "expand",
        "edges",
        "edgeTrim",
        "fringing",
        "samples"
      ]
    },
    {
      "skslFile": "lensAberration.sksl",
      "uniforms": [
        "abModel",
        "geometry",
        "centre",
        "angle",
        "dispersion",
        "focusWave",
        "smoothing",
        "aberration",
        "redScale",
        "greenScale",
        "blueScale",
        "smear",
        "falloff",
        "mapChannel",
        "mapAmplitude",
        "mapFromGradient",
        "abIntensity",
        "samples"
      ]
    },
    {
      "skslFile": "lensPrepare.sksl",
      "uniforms": [
        "bokehThreshold",
        "bokehGamma"
      ]
    },
    {
      "skslFile": "lensSegment.sksl",
      "uniforms": [
        "defocus",
        "blades",
        "rotation",
        "catsEye",
        "catsEyeFalloff",
        "ringBias",
        "cocSource",
        "focus",
        "aperture",
        "dither"
      ],
      "constants": {
        "segIndex": 0.0
      }
    },
    {
      "skslFile": "lensSegment.sksl",
      "uniforms": [
        "defocus",
        "blades",
        "rotation",
        "catsEye",
        "catsEyeFalloff",
        "ringBias",
        "cocSource",
        "focus",
        "aperture",
        "dither"
      ],
      "constants": {
        "segIndex": 1.0
      }
    },
    {
      "skslFile": "lensSegment.sksl",
      "uniforms": [
        "defocus",
        "blades",
        "rotation",
        "catsEye",
        "catsEyeFalloff",
        "ringBias",
        "cocSource",
        "focus",
        "aperture",
        "dither"
      ],
      "constants": {
        "segIndex": 2.0
      }
    },
    {
      "skslFile": "lensDefocus.sksl",
      "uniforms": [
        "bokehGamma",
        "defocus",
        "blades",
        "rotation",
        "catsEye",
        "catsEyeFalloff",
        "ringBias",
        "cocSource",
        "focus",
        "aperture",
        "exposure",
        "gain",
        "dither"
      ],
      "constants": {
        "segIndex": 3.0
      }
    },
    {
      "skslFile": "lensScatter.sksl",
      "uniforms": [
        "kernel",
        "size",
        "kernelRotation",
        "ringFrequency",
        "axialRed",
        "axialGreen",
        "axialBlue",
        "scatterThreshold",
        "scatterGain",
        "scatterBlend",
        "samples",
        "amount"
      ]
    }
  ],
  "attributes": {
    "profile": {
      "type": "enum",
      "default": 5,
      "enumValues": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "dimming": "distortion == 0"
    },
    "distortion": {
      "type": "double",
      "default": 1.0,
      "softMin": -4.0,
      "softMax": 4.0,
      "step": 0.05
    },
    "squeeze": {
      "type": "double",
      "default": 1.0,
      "min": 0.01,
      "softMax": 2.5,
      "step": 0.01,
      "dimming": "distortion == 0"
    },
    "centreOffset": {
      "type": "double2",
      "default": {
        "x": 0.0,
        "y": 0.0
      },
      "children": {
        "*": {
          "step": 0.005
        }
      }
    },
    "expand": {
      "type": "double",
      "default": 1.0,
      "min": 0.01,
      "softMax": 2.0,
      "step": 0.01
    },
    "edges": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2
      ]
    },
    "edgeTrim": {
      "type": "double2",
      "default": {
        "x": 1.0,
        "y": 1.0
      },
      "children": {
        "*": {
          "step": 0.5
        }
      },
      "dimming": "edges == 0"
    },
    "fringing": {
      "type": "double",
      "default": 0.5,
      "min": 0.0,
      "softMax": 4.0,
      "step": 0.05
    },
    "abModel": {
      "type": "enum",
      "default": 3,
      "enumValues": [
        0,
        1,
        2,
        3
      ]
    },
    "geometry": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2
      ],
      "dimming": "abModel == 2 || abModel == 3"
    },
    "centre": {
      "type": "double2",
      "default": {
        "x": 0.0,
        "y": 0.0
      },
      "children": {
        "*": {
          "step": 1.0
        }
      },
      "dimming": "abModel == 2 || abModel == 3"
    },
    "angle": {
      "type": "double",
      "default": 0.0,
      "softMin": -180.0,
      "softMax": 180.0,
      "step": 0.5,
      "dimming": "abModel == 3"
    },
    "dispersion": {
      "type": "double",
      "default": 0.02,
      "softMin": -1.0,
      "softMax": 1.0,
      "step": 0.005,
      "dimming": "abModel == 1 || abModel == 3"
    },
    "focusWave": {
      "type": "double",
      "default": 0.0,
      "softMin": -1.0,
      "softMax": 1.0,
      "step": 0.05,
      "dimming": "abModel == 1 || abModel == 3"
    },
    "smoothing": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 2.0,
      "step": 0.05,
      "dimming": "abModel != 0"
    },
    "aberration": {
      "type": "double",
      "default": 6.0,
      "softMin": -60.0,
      "softMax": 60.0,
      "step": 0.5,
      "dimming": "abModel != 1"
    },
    "redScale": {
      "type": "double",
      "default": 1.0,
      "softMin": -3.0,
      "softMax": 3.0,
      "step": 0.05,
      "dimming": "abModel != 1"
    },
    "greenScale": {
      "type": "double",
      "default": 0.0,
      "softMin": -3.0,
      "softMax": 3.0,
      "step": 0.05,
      "dimming": "abModel != 1"
    },
    "blueScale": {
      "type": "double",
      "default": -1.0,
      "softMin": -3.0,
      "softMax": 3.0,
      "step": 0.05,
      "dimming": "abModel != 1"
    },
    "smear": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "abModel != 1"
    },
    "falloff": {
      "type": "double",
      "default": 1.0,
      "min": 0.0001,
      "softMax": 6.0,
      "step": 0.05,
      "dimming": "abModel != 1 || geometry == 2"
    },
    "mapChannel": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "dimming": "abModel != 2"
    },
    "mapAmplitude": {
      "type": "double",
      "default": 40.0,
      "softMin": -400.0,
      "softMax": 400.0,
      "step": 1.0,
      "dimming": "abModel != 2"
    },
    "mapFromGradient": {
      "type": "bool",
      "default": true,
      "dimming": "abModel != 2"
    },
    "abIntensity": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "softMax": 4.0,
      "step": 0.05,
      "dimming": "abModel == 1 || abModel == 3"
    },
    "bokehThreshold": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "max": 0.999,
      "step": 0.01,
      "dimming": "defocus <= 0"
    },
    "bokehGamma": {
      "type": "double",
      "default": 1.0,
      "min": 0.1,
      "softMax": 8.0,
      "step": 0.05,
      "dimming": "defocus <= 0"
    },
    "defocus": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 400.0,
      "step": 0.5
    },
    "blades": {
      "type": "enum",
      "default": 6,
      "enumValues": [
        4,
        6,
        8
      ],
      "dimming": "defocus <= 0"
    },
    "rotation": {
      "type": "double",
      "default": 0.0,
      "softMin": -180.0,
      "softMax": 180.0,
      "step": 0.5,
      "dimming": "defocus <= 0"
    },
    "catsEye": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "defocus <= 0"
    },
    "catsEyeFalloff": {
      "type": "double",
      "default": 1.0,
      "min": 0.1,
      "softMax": 4.0,
      "step": 0.05,
      "dimming": "catsEye <= 0"
    },
    "ringBias": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "defocus <= 0"
    },
    "cocSource": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2,
        3,
        4
      ],
      "dimming": "defocus <= 0"
    },
    "focus": {
      "type": "double",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "defocus <= 0 || cocSource == 0"
    },
    "aperture": {
      "type": "double",
      "default": 2.5,
      "min": 0.0,
      "softMax": 8.0,
      "step": 0.05,
      "dimming": "defocus <= 0 || cocSource == 0"
    },
    "exposure": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 8.0,
      "step": 0.05,
      "dimming": "defocus <= 0"
    },
    "gain": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "softMax": 8.0,
      "step": 0.05,
      "dimming": "defocus <= 0"
    },
    "dither": {
      "type": "bool",
      "default": true,
      "dimming": "defocus <= 0"
    },
    "kernel": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2,
        3
      ],
      "dimming": "size <= 0"
    },
    "size": {
      "type": "double",
      "default": 0.0,
      "min": 0.0,
      "softMax": 300.0,
      "step": 0.5
    },
    "kernelRotation": {
      "type": "double",
      "default": 0.0,
      "softMin": -180.0,
      "softMax": 180.0,
      "step": 0.5,
      "dimming": "size <= 0 || kernel != 1"
    },
    "ringFrequency": {
      "type": "double",
      "default": 6.0,
      "min": 0.1,
      "softMax": 40.0,
      "step": 0.1,
      "dimming": "size <= 0 || kernel != 2"
    },
    "axialRed": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "softMax": 3.0,
      "step": 0.05,
      "dimming": "size <= 0"
    },
    "axialGreen": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "softMax": 3.0,
      "step": 0.05,
      "dimming": "size <= 0"
    },
    "axialBlue": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "softMax": 3.0,
      "step": 0.05,
      "dimming": "size <= 0"
    },
    "scatterThreshold": {
      "type": "double",
      "default": 0.7,
      "min": 0.0,
      "max": 0.999,
      "step": 0.01,
      "dimming": "size <= 0"
    },
    "scatterGain": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "softMax": 8.0,
      "step": 0.05,
      "dimming": "size <= 0"
    },
    "scatterBlend": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1,
        2
      ],
      "dimming": "size <= 0"
    },
    "samples": {
      "type": "double",
      "default": 16.0,
      "min": 2.0,
      "max": 32.0,
      "step": 1.0
    },
    "amount": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    "displaceMap": {
      "type": "shaderData",
      "supportedInputNodeTypes": [
        "shader",
        "shaderArray"
      ],
      "subUI": true,
      "defaultSubnodeType": "noiseShader",
      "dimming": "abModel != 2"
    },
    "defocusMap": {
      "type": "shaderData",
      "supportedInputNodeTypes": [
        "shader",
        "shaderArray"
      ],
      "subUI": true,
      "defaultSubnodeType": "noiseShader",
      "dimming": "cocSource != 4"
    }
  },
  "triggers": {
    "out": [
      "profile",
      "distortion",
      "squeeze",
      "centreOffset",
      "expand",
      "edges",
      "edgeTrim",
      "fringing",
      "abModel",
      "geometry",
      "centre",
      "angle",
      "dispersion",
      "focusWave",
      "smoothing",
      "aberration",
      "redScale",
      "greenScale",
      "blueScale",
      "smear",
      "falloff",
      "mapChannel",
      "mapAmplitude",
      "mapFromGradient",
      "abIntensity",
      "bokehThreshold",
      "bokehGamma",
      "defocus",
      "blades",
      "rotation",
      "catsEye",
      "catsEyeFalloff",
      "ringBias",
      "cocSource",
      "focus",
      "aperture",
      "exposure",
      "gain",
      "dither",
      "kernel",
      "size",
      "kernelRotation",
      "ringFrequency",
      "axialRed",
      "axialGreen",
      "axialBlue",
      "scatterThreshold",
      "scatterGain",
      "scatterBlend",
      "samples",
      "amount",
      "displaceMap",
      "defocusMap"
    ]
  },
  "UI": {
    "tabs": [
      {
        "id": "filter",
        "attributeOrder": [
          "profile",
          "distortion",
          "squeeze",
          "centreOffset",
          "expand",
