{
  "author": "samMularczyk",
  "type": "godray",
  "superType": "thirdPartyFilter",
  "version": "1.0",
  "skslFile": "godray.sksl",
  "attributes": {
    "angle": {
      "type": "double",
      "default": 30.0,
      "softMin": -180.0,
      "softMax": 180.0,
      "step": 0.5,
      "dimming": "parallel == false"
    },
    "parallel": {
      "type": "bool",
      "default": true
    },
    "light": {
      "type": "double2",
      "default": {
        "x": 0.0,
        "y": 0.0
      },
      "children": {
        "*": {
          "step": 1.0
        }
      },
      "dimming": "parallel == true"
    },
    "rayMode": {
      "type": "enum",
      "default": 0,
      "enumValues": [
        0,
        1
      ]
    },
    "gain": {
      "type": "double",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "rayMode == 1"
    },
    "lacunarity": {
      "type": "double",
      "default": 2.5,
      "min": 0.1,
      "softMax": 6.0,
      "step": 0.05,
      "dimming": "gain <= 0 || rayMode == 1"
    },
    "density": {
      "type": "double",
      "default": 0.1,
      "min": 0.1,
      "softMax": 64.0,
      "step": 0.5,
      "dimming": "gain <= 0 || rayMode == 1"
    },
    "speed": {
      "type": "double",
      "default": 0.001,
      "min": 0.0,
      "softMax": 0.05,
      "step": 0.0005
    },
    "scatterG": {
      "type": "double",
      "default": 0.4,
      "min": 0.0,
      "max": 0.95,
      "step": 0.01,
      "dimming": "rayMode == 1"
    },
    "blur": {
      "type": "double",
      "default": 0.78,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "rayMode == 1"
    },
    "spotty": {
      "type": "double",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "rayMode == 0"
    },
    "rayIntensity": {
      "type": "double",
      "default": 0.8,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "rayMode == 0"
    },
    "rayCount": {
      "type": "double",
      "default": 10.0,
      "min": 0.5,
      "softMax": 60.0,
      "step": 0.25,
      "dimming": "rayMode == 0"
    },
    "spread": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "rayMode == 0 || parallel == true"
    },
    "coreSize": {
      "type": "double",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "rayMode == 0"
    },
    "coreGlow": {
      "type": "double",
      "default": 0.4,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "dimming": "rayMode == 0"
    },
    "rayColor": {
      "type": "color",
      "default": {
        "type": "Color",
        "r": 255,
        "g": 255,
        "b": 255,
        "a": 255
      }
    },
    "rayColor2": {
      "type": "color",
      "default": {
        "type": "Color",
        "r": 255,
        "g": 255,
        "b": 255,
        "a": 255
      }
    },
    "time": {
      "type": "double",
      "default": 0.0,
      "compConnect": "time",
      "dimming": "gain <= 0 || amount <= 0"
    },
    "amount": {
      "type": "double",
      "default": 1.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    }
  },
  "triggers": {
    "out": [
      "angle",
      "parallel",
      "light",
      "rayMode",
      "gain",
      "lacunarity",
      "density",
      "speed",
      "scatterG",
      "blur",
      "spotty",
      "rayIntensity",
      "rayCount",
      "spread",
      "coreSize",
      "coreGlow",
      "rayColor",
      "rayColor2",
      "time",
      "amount"
    ]
  },
  "UI": {
    "icon": "godray.png",
    "tabs": [
      {
        "id": "filter",
        "attributeOrder": [
          "rayMode",
          "parallel",
          "angle",
          "light",
          "---Shape",
          "spread",
          "speed",
          "time",
          "---Volumetric",
          "density",
          "gain",
          "lacunarity",
          "scatterG",
          "blur",
          "---Light Field",
          "rayCount",
          "rayIntensity",
          "spotty",
          "coreSize",
          "coreGlow",
          "---Output",
          "rayColor",
          "rayColor2",
          "---A",
          "amount",
          "---Ported from pixi.js filters (MIT) \u00b7 Light Field model after Paper Shaders (Apache-2.0)"
        ]
      }
    ]
  }
}
