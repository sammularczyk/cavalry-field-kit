          "---Highlights",
          "bokehThreshold",
          "bokehGamma",
          "gain",
          "exposure",
          "dither",
          "---Edges",
          "edges",
          "edgeTrim"
        ]
      },
      {
        "id": "map",
        "attributeOrder": [
          "mapMode",
          "occlusion",
          "defocusMap"
        ]
      },
      {
        "id": "artefacts",
        "attributeOrder": [
          "size",
          "kernel",
          "kernelRotation",
          "ringFrequency",
          "---Axial Chromatic",
          "axialRed",
          "axialGreen",
          "axialBlue",
          "---Output",
          "scatterThreshold",
          "scatterGain",
          "scatterBlend",
          "samples",
          "amount",
          "---Inspired by hornet, NLIBS & Florian Lorber"
        ]
      }
    ],
    "controls": {
      "defocusMap": "nodeInput"
    }
  }
}
