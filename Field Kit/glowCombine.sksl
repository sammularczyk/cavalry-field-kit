// Glow, pass 13 of 13 - Field Kit
// Normalises the accumulated ladder, optionally splits it chromatically, then
// grades and composites over the untouched layer.
//
// Chromatic band weights ported from "Spectral_Aberration_Pro_V2" by Marten
// Blumen (BSD-3): the seven tints are normalised so they sum to exactly white,
// which is what makes the ratio below 1.0 at zero dispersion.

uniform float  angle;
uniform float  chromatic;
uniform float  dispersion;
uniform float  bloomAmount;
uniform float  haloAmount;    // lenticular halo - Spencer's f3 term
uniform float  haloRadius;
uniform float  haloSoftness;
uniform float  streakAmount;  // gates the fold-in below
uniform float  blur;          // streak softness, folded in from its own pass  // width of the ring, as a fraction of its radius    // px; the ring sits at a fixed radius, not a falloff
uniform float  srcBlack;      // the halo re-derives highlights, so it needs
uniform float  srcWhite;      // the same three grade controls pass 0 used
uniform float  response;
uniform float  steps;
uniform float  persistence;
uniform float  intensity;
uniform float  saturation;    // of the glow itself, not the picture
uniform half4  tint;
uniform float  blend;         // enum: 0 Add, 1 Screen, 2 Max, 3 Effect Only
uniform float  amount;

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader childShader;   // the accumulated glow
uniform shader original;      // untouched input - MUST be declared last

float bandWave(int i) {
    if (i == 0) { return  1.00; }
    if (i == 1) { return  0.66; }
    if (i == 2) { return  0.33; }
    if (i == 3) { return  0.00; }
    if (i == 4) { return -0.33; }
    if (i == 5) { return -0.66; }
    return -1.00;
}
float3 bandTint(int i) {
    if (i == 0) { return float3(1.0, 0.0, 0.0); }
    if (i == 1) { return float3(1.0, 0.5, 0.0); }
    if (i == 2) { return float3(1.0, 1.0, 0.0); }
    if (i == 3) { return float3(0.0, 1.0, 0.0); }
    if (i == 4) { return float3(0.0, 0.5, 1.0); }
    if (i == 5) { return float3(0.0, 0.0, 1.0); }
    return float3(0.2, 0.0, 0.5);
}
const float3 BAND_NORM = float3(0.3125, 0.3333, 0.4);

// THE LENTICULAR HALO - Spencer, Shirley, Zimmerman & Greenberg, "Physically-
// Based Glare Effects for Digital Images" (SIGGRAPH 1995), their f3 term.
//
// Unlike bloom, this is not a falloff at all: it is a coloured RING standing at
// a fixed angular radius from the source, produced by diffraction off the
// radial fibre lattice of the eye's lens. Because diffraction angle scales with
// wavelength, red lands furthest out and blue sits inside it - so the ring is
// chromatic by construction rather than by being tinted. It is the thing you
// see around a streetlight at night, and nothing else in this kit can make it.
//
// Gathered as a ring rather than convolved: sampling the highlights AT the ring
// radius in a dozen directions is the same operation as convolving with an
// annulus, and costs a dozen taps instead of a pass.
float3 haloHighlights(float2 coord) {
    half4 c = original.eval(coord);
    float3 lin = c.a > 0.0 ? float3(c.rgb / c.a) : float3(0.0);
    float bp = srcBlack;
    float wp = max(srcWhite, bp + 0.0001);
    return pow(clamp((lin - bp) / (wp - bp), 0.0, 1e4),
               float3(max(response, 0.0001)));
}

float haloHash(float2 p) {
    p = fract(p * float2(0.1031, 0.11369));
    p += dot(p, p.yx + 19.19);
    return fract((p.x + p.y) * p.x);
}

float3 lenticularHalo(float2 fragCoord) {
    if (haloAmount <= 0.0 || haloRadius <= 0.0) { return float3(0.0); }
    // 20 directions, and each tap's RADIUS jittered a few percent as well as
    // its angle. Twelve taps on a razor-thin ring read as twelve copies, and
    // angular jitter alone converts that banding into noise rather than
    // smoothing it - which is what made the ring look grainy. Giving the ring
    // real width also fills the gap between the per-channel radii, so red and
    // blue blend into a graded fringe instead of separating into hard rainbow
    // bands 20 pixels apart.
    const int N = 20;
    const float3 LAMBDA = float3(1.13, 1.0, 0.82);   // 620/550/450nm
    float jit = haloHash(fragCoord) * 6.28318530718;
    float3 acc = float3(0.0);
    for (int i = 0; i < N; i++) {
        float fi = float(i);
        float a = fi / float(N) * 6.28318530718 + jit;
        float2 d = float2(cos(a), sin(a));
        // Spread across the ring's width, offset per pixel so the spread does
        // not itself become a pattern.
        // Ring width. A thin ring is a sharp chromatic band; a wide one is a
        // soft halo whose colours blend through each other.
        float hw = clamp(haloSoftness, 0.0, 1.0) * 0.6;
        float rw = 1.0 - hw * 0.5 + hw * fract(fi * 0.618034 + haloHash(fragCoord + 3.7));
        acc.r += haloHighlights(fragCoord + d * (haloRadius * LAMBDA.r * rw)).r;
        acc.g += haloHighlights(fragCoord + d * (haloRadius * LAMBDA.g * rw)).g;
        acc.b += haloHighlights(fragCoord + d * (haloRadius * LAMBDA.b * rw)).b;
    }
    return acc / float(N) * clamp(haloAmount, 0.0, 4.0);
}


half4 main(float2 fragCoord) {
    // The streak's perpendicular gaussian, folded in here rather than run as
    // its own pass. An early-out pass still writes a full-resolution buffer, so
    // at 14 passes the count itself was the floor on cost, not the tap budget -
    // and this pass already reads childShader, so the blur is free of any extra
    // buffer.
    float3 glow;
    if (blur > 0.0 && streakAmount > 0.0) {
        float sa = radians(angle);
        float2 sperp = float2(-sin(sa), cos(sa));
        float3 bsum = float3(0.0);
        float  bden = 0.0;
        for (int i = -8; i <= 8; i++) {
            float f = float(i) / 8.0;
            float w = exp(-2.0 * f * f);
            bsum += float3(childShader.eval(fragCoord + sperp * (f * blur)).rgb) * w;
            bden += w;
        }
        glow = bsum / max(bden, 0.0001);
    } else {
        glow = float3(childShader.eval(fragCoord).rgb);
    }

    // No global normalisation here any more - glowBloom divides each rung as
    // it adds it, so the buffer arrives already scaled and the streak that was
    // added after the bloom is not caught up in it.

    // Chromatic split, as a per-channel ratio on the accumulated glow rather
    // than replacing it, so turning it up does not shorten the streak.
    float chro = clamp(chromatic, 0.0, 1.0);
    if (chro > 0.0) {
        float ang = radians(angle);
        float2 dir = float2(cos(ang), sin(ang));
        float3 base = float3(childShader.eval(fragCoord).rgb);
        float3 acc = float3(0.0);
        // Jittered band positions. Seven fixed offsets are seven discrete
        // copies, and at any real Dispersion you see them as banding across the
        // fringe - a spectrum is continuous, and sampling it on a fixed lattice
        // is the same mistake as an unjittered blur ladder. Offsetting every
        // band by up to half a step, differently per pixel, turns those steps
        // into fine noise that the eye integrates back into a smooth ramp.
        float bj = (haloHash(fragCoord + 11.3) - 0.5) / 6.0;
        for (int b = 0; b < 7; b++) {
            float wpos = clamp(bandWave(b) + bj * 2.0, -1.0, 1.0);
            float3 v = float3(childShader.eval(
                fragCoord + dir * (wpos * dispersion)).rgb);
            acc += v * bandTint(b);
        }
        acc *= BAND_NORM;
        float3 ratio = clamp(acc / max(base, float3(0.001)), 0.0, 4.0);
        glow *= mix(float3(1.0), ratio, chro);
    }

    // Saturation of the VEIL - applied before the halo joins it.
    //
    // Scattering off dust and lens imperfections is Mie scattering, which for
    // particles larger than the wavelength is very nearly achromatic - so real
    // veiling glare drifts toward neutral rather than carrying the source's
    // colour. A bright red lamp throws a whitish veil, not a red one, and bloom
    // that reproduces the source hue faithfully is what gives away that it is a
    // blur rather than scattered light. Above 1 goes the other way, for when
    // the colour is the point.
    float glum = dot(glow, float3(0.2126, 0.7152, 0.0722));
    glow = max(mix(float3(glum), glow, max(saturation, 0.0)), 0.0);

    glow += lenticularHalo(fragCoord);

    // apGlow's persistence gains the wide end of the ladder. The chain has
    // already mixed the widths, so this acts on the result as a soft-knee gain
    // rather than per-step - the same control, applied once.
    glow = pow(max(glow, 0.0), float3(1.0 / max(persistence, 0.0001)));
    glow = clamp(glow * max(intensity, 0.0) * float3(tint.rgb), 0.0, 1.0);

    half4 src = original.eval(fragCoord);
    float3 lin = src.a > 0.0 ? float3(src.rgb / src.a) : float3(0.0);

    int bm = int(blend);
    float3 outRgb =
        bm == 1 ? 1.0 - (1.0 - lin) * (1.0 - glow) :
        bm == 2 ? max(lin, glow) :
        bm == 3 ? glow :
        min(lin + glow, 1.0);

    // Glow spreads past the source, so alpha has to follow it out.
    float ga = clamp(dot(glow, float3(0.3333)), 0.0, 1.0);
    half a = half(bm == 3 ? ga : clamp(max(float(src.a), ga), 0.0, 1.0));

    return mix(src, half4(half3(clamp(outRgb, 0.0, 1.0)) * a, a),
               half(clamp(amount, 0.0, 1.0)));
}
