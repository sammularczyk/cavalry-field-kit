// Godray - Field Kit
// Volumetric light shafts (crepuscular rays) radiating from a point, or
// travelling in parallel from a direction - the shafts you get through cloud
// or a window. Nothing else in this kit does this: Glow is highlight bloom,
// Lens Flare is ghost geometry.
//
// Ported from pixi.js filters' GodrayFilter (MIT licence),
// github.com/pixijs/filters, src/godray - itself after a codepen original by
// Alain Galvan. The turbulence underneath is Ashima/Stefan Gustavson's
// classic periodic Perlin noise (webgl-noise, MIT), which pixi's own filter
// also uses verbatim; it is reproduced here the same way.
//
// pixi's filter runs in Y-DOWN texture space (0,0 top-left) on premultiplied-
// alpha-agnostic render targets, and its `center` is an absolute pixel
// position. This port works in Cavalry's Y-UP, pixel-centre-addressed,
// premultiplied convention instead: the frame coordinate is flipped to Y-down
// before reusing pixi's own ray-projection formulas, `light` is an offset
// from the layer centre (matching every other position control in this kit)
// rather than an absolute position, and the ray brightness is folded into
// BOTH colour and alpha on the way out, since the shafts spread across the
// whole frame rather than staying inside whatever alpha the layer arrived
// with - alpha has to follow them out or they get clipped to the layer's
// shape. `density` is this port's own addition, standing in for the fixed
// real-pixel frequency pixi's version got for free from working in absolute
// texture units instead of a normalised 0..1 frame.
//
// gain <= 0 or amount <= 0 is an exact passthrough.
//
// Uniform order matches the attribute order in definitions.json. Single pass
// (pass 0), so the layer is read only through childShader - there is no
// "original" input on the first pass.

uniform float  angle;        // degrees; ray direction when parallel
uniform float  parallel;     // bool: true = parallel rays, false = radiating
uniform float2 light;        // px offset from layer centre; radiating only
uniform float  rayMode;      // enum: 0 Volumetric, 1 Light Field
uniform float  gain;         // 0 = passthrough; turbulence octave gain
uniform float  lacunarity;   // frequency multiplier per octave
uniform float  density;      // shaft frequency/spacing
uniform float  speed;        // drift rate of the turbulence
uniform float  scatterG;     // Henyey-Greenstein asymmetry, 0 isotropic
uniform float  blur;         // softens the shafts across their width
uniform float  spotty;       // Light Field: how fast rays break up along their length
uniform float  rayIntensity; // Light Field: thins the shafts
uniform float  rayCount;     // Light Field: angular frequency, ~shafts around
uniform float  spread;       // Light Field: angular extent of the cone, 1 = all round
uniform float  coreSize;     // Light Field: radius of the glow at the source
uniform float  coreGlow;     // Light Field: brightness of that glow
uniform half4  rayColor;     // straight RGBA; white leaves the rays uncoloured
uniform half4  rayColor2;    // second colour, interleaved shaft by shaft
uniform float  time;         // auto-connected to comp time
uniform float  amount;       // 0..1 overall opacity

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader childShader;   // pass 0 input = the layer being filtered

// --- Ashima/Stefan Gustavson periodic Perlin noise (webgl-noise, MIT) ---
// Straight translation of perlin.frag from pixi.js filters' godray source -
// vecN becomes floatN, everything else is unchanged.

float3 mod289f3(float3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
float4 mod289f4(float4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
float4 permute(float4 x) { return mod289f4(((x * 34.0) + 1.0) * x); }
float4 taylorInvSqrt(float4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
float3 noiseFade(float3 t) { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }

// Classic Perlin noise, periodic variant.
float pnoise(float3 P, float3 rep) {
    float3 Pi0 = mod(floor(P), rep);
    float3 Pi1 = mod(Pi0 + float3(1.0), rep);
    Pi0 = mod289f3(Pi0);
    Pi1 = mod289f3(Pi1);
    float3 Pf0 = fract(P);
    float3 Pf1 = Pf0 - float3(1.0);
    float4 ix = float4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
    float4 iy = float4(Pi0.yy, Pi1.yy);
    float4 iz0 = float4(Pi0.zzzz);
    float4 iz1 = float4(Pi1.zzzz);

    float4 ixy = permute(permute(ix) + iy);
    float4 ixy0 = permute(ixy + iz0);
    float4 ixy1 = permute(ixy + iz1);

    float4 gx0 = ixy0 * (1.0 / 7.0);
    float4 gy0 = fract(floor(gx0) * (1.0 / 7.0)) - 0.5;
    gx0 = fract(gx0);
    float4 gz0 = float4(0.5) - abs(gx0) - abs(gy0);
    float4 sz0 = step(gz0, float4(0.0));
    gx0 -= sz0 * (step(0.0, gx0) - 0.5);
    gy0 -= sz0 * (step(0.0, gy0) - 0.5);

    float4 gx1 = ixy1 * (1.0 / 7.0);
    float4 gy1 = fract(floor(gx1) * (1.0 / 7.0)) - 0.5;
    gx1 = fract(gx1);
    float4 gz1 = float4(0.5) - abs(gx1) - abs(gy1);
    float4 sz1 = step(gz1, float4(0.0));
    gx1 -= sz1 * (step(0.0, gx1) - 0.5);
    gy1 -= sz1 * (step(0.0, gy1) - 0.5);

    float3 g000 = float3(gx0.x, gy0.x, gz0.x);
    float3 g100 = float3(gx0.y, gy0.y, gz0.y);
    float3 g010 = float3(gx0.z, gy0.z, gz0.z);
    float3 g110 = float3(gx0.w, gy0.w, gz0.w);
    float3 g001 = float3(gx1.x, gy1.x, gz1.x);
    float3 g101 = float3(gx1.y, gy1.y, gz1.y);
    float3 g011 = float3(gx1.z, gy1.z, gz1.z);
    float3 g111 = float3(gx1.w, gy1.w, gz1.w);

    float4 norm0 = taylorInvSqrt(float4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
    g000 *= norm0.x; g010 *= norm0.y; g100 *= norm0.z; g110 *= norm0.w;
    float4 norm1 = taylorInvSqrt(float4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
    g001 *= norm1.x; g011 *= norm1.y; g101 *= norm1.z; g111 *= norm1.w;

    float n000 = dot(g000, Pf0);
    float n100 = dot(g100, float3(Pf1.x, Pf0.yz));
    float n010 = dot(g010, float3(Pf0.x, Pf1.y, Pf0.z));
    float n110 = dot(g110, float3(Pf1.xy, Pf0.z));
    float n001 = dot(g001, float3(Pf0.xy, Pf1.z));
    float n101 = dot(g101, float3(Pf1.x, Pf0.y, Pf1.z));
    float n011 = dot(g011, float3(Pf0.x, Pf1.yz));
    float n111 = dot(g111, Pf1);

    float3 fadeXYZ = noiseFade(Pf0);
    float4 nZ  = mix(float4(n000, n100, n010, n110), float4(n001, n101, n011, n111), fadeXYZ.z);
    float2 nYZ = mix(nZ.xy, nZ.zw, fadeXYZ.y);
    float  nXYZ = mix(nYZ.x, nYZ.y, fadeXYZ.x);
    return 2.2 * nXYZ;
}

// Six fixed octaves, matching pixi's own loop count. The bound is a compile-
// time constant, since SkSL loop bounds cannot be driven by a uniform; `sum`
// accumulates real noise samples on every iteration, never bare literals, so
// it cannot fold away to a constant.
float turbulence(float3 P, float3 rep, float lac, float g) {
    float sum = 0.0;
    float sc = 1.0;
    float amp = 1.0;
    for (int i = 0; i < 6; i++) {
        sum += amp * pnoise(P * sc, rep);
        sc *= lac;
        amp *= g;
    }
    return abs(sum);
}

// ---------------------------------------------------- Light Field ray model
//
// A different mechanism from the turbulence above, not a variation on it. The
// noise is sampled in POLAR space - (angle x frequency, radius) - so the
// angular coordinate sets how many shafts there are and the radial coordinate
// says where along a shaft you are. Nothing is integrated along the ray, so it
// is O(1) where a marched godray is O(N).
//
// Four things make it look unlike the turbulence model, and the same four are
// why it costs about two noise evaluations instead of eighteen:
//
//   - VALUE noise, not Perlin. Value noise has visible axis-aligned blockiness
//     at one octave, and in polar space that blockiness becomes RADIAL banding,
//     which is exactly what reads as shafts. Perlin's zero-at-lattice-points
//     property would smooth away the very artefact we want.
//   - Two sparse fields MULTIPLIED. A product of two sparse fields is far
//     sparser than either, which is where the crisp separated shafts come from.
//     An fbm sum gives soft cloudy shafts instead.
//   - One octave raised to a power, instead of many octaves. pow(n, 1..4) does
//     the thinning that turbulence would otherwise do, at a quarter the cost.
//   - Two counter-scrolling radial rates, so the two fields slide past each
//     other and shafts beat in and out of existence in place rather than simply
//     streaming outward.
const float TWO_PI = 6.28318530718;

float grHash21(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float grVnoise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);        // cubic, not quintic - cheaper
    return mix(mix(grHash21(i), grHash21(i + float2(1.0, 0.0)), u.x),
               mix(grHash21(i + float2(0.0, 1.0)), grHash21(i + float2(1.0, 1.0)), u.x), u.y);
}

// The atan seam at +-pi is handled by evaluating TWO angular parameterisations
// and cross-fading between them across the seam, which is cheaper and more
// robust than any wrapping trick - and the cross-fade band is placed where the
// seam actually is.
float raysShape(float dxs, float a, float rr, float freq, float inten) {
    float nL = pow(clamp(grVnoise(float2(a * freq, rr)), 0.0, 1.0), inten);
    float aR = fract(a / TWO_PI) * TWO_PI;
    float nR = pow(clamp(grVnoise(float2(aR * freq, rr)), 0.0, 1.0), inten);
    return mix(nR, nL, smoothstep(-0.15, 0.15, dxs));
}

half4 main(float2 fragCoord) {
    half4 src = childShader.eval(fragCoord);

    // Exact passthrough - nothing upstream should be visible.
    if (gain <= 0.0 || amount <= 0.0) { return src; }

    float2 res = max(resolution, float2(1.0));
    float aspect = res.y / res.x;

    // fragCoord is pixel-centre addressed and Y-UP; pixi's ray-projection
    // maths is written for a top-left-origin, Y-DOWN texture space, so build
    // a normalised coordinate in THAT convention before reusing it.
    float2 uv = (fragCoord - rectCentre) / res + 0.5;
    uv.y = 1.0 - uv.y;

    bool isParallel = parallel > 0.5;

    // `light` is a pixel offset from the layer centre, same convention as
    // every other position control in this kit - converted into the same
    // flipped, normalised space as uv above. Hoisted out of the branch because
    // the Light Field model needs the polar coordinates in both cases.
    float2 lightUV = float2(0.5 + light.x / res.x, 0.5 - light.y / res.y);
    float dx = uv.x - lightUV.x;
    float dy = (uv.y - lightUV.y) * aspect;
    float dist = sqrt(dx * dx + dy * dy) + 0.00001;

    float d;
    if (isParallel) {
        float rad  = radians(angle);
        float cosA = cos(rad);
        float sinA = sin(rad);
        d = cosA * uv.x + sinA * uv.y * aspect;
    } else {
        d = dy / dist;
    }

    // Polar ray coordinates. Parallel rays have no origin to be angular about,
    // so the frame's own axes stand in: across the frame is "angle", along it
    // is "radius".
    float rayAngle = isParallel ? (uv.x * TWO_PI) : atan(dy, dx);
    // Radial rate matters more than it looks. The noise decorrelates as this
    // coordinate advances, which is what gives a shaft a finite length - too
    // fast and the rays break into blobs a short way out instead of reaching
    // across the frame.
    float rayRad   = isParallel ? (uv.y * 2.0)    : (dist * 2.0);
    float raySeam  = isParallel ? (uv.x - 0.5)    : dx;

    float dens = max(density, 0.001);
    float3 dir = float3(d, d, 0.0) * dens;
    // The 0.05 was baked in; Speed exposes it so the drift can be slowed to a
    // crawl or stopped outright without disconnecting time.
    float tt = time * max(speed, 0.0);
    // Blur works ACROSS the shafts rather than over the picture: the pattern
    // comes from the turbulence sampled along the angular coordinate, so
    // averaging a few neighbouring angles softens shaft edges without
    // touching the image itself, and costs nothing at zero.
    float mistField;
    if (rayMode > 0.5) {
        // ---- Light Field --------------------------------------------------
        float inten = 4.0 - 3.0 * clamp(rayIntensity, 0.0, 1.0);
        // Deliberately NOT Density. That control is the turbulence model's noise
        // scale and runs 0.1 to 64; this one is an angular frequency where the
        // useful range is single digits. One slider serving both would be
        // wrong at one end or the other, so they are separate and each dims in
        // the mode it does not belong to.
        float lfFreq = max(rayCount, 0.5);
        float r1 = rayRad - 3.0 * tt;
        // The second field advances along the ray faster, so the two slide out
        // of step with each other and the product breaks up with distance.
        // Break Up is exactly that rate.
        float r2 = rayRad * (0.6 + clamp(spotty, 0.0, 1.0) * 2.4) - 2.0 * tt;
        float ray = raysShape(raySeam, rayAngle, r1, lfFreq,       inten)
                  * raysShape(raySeam, rayAngle, r2, lfFreq * 0.8, inten);

        // The core is both an ADDITIVE glow at the source and a multiplicative
        // boost of the rays near it - a shaft is five times brighter where the
        // glow is full. That coupling is most of why this reads as light
        // pouring out of something rather than as a blob with lines over it.
        float ms   = 10.0 * max(coreSize, 0.0);
        float core = pow(clamp(coreGlow, 0.0, 1.0), 0.3)
                   * (1.0 - smoothstep(0.02 * ms, max(ms, 1e-6), 3.0 * dist));
        core = pow(core, 5.0);
        ray += (1.0 + 4.0 * ray) * core;

        // Below 1, the rays occupy a wedge centred on Angle instead of going
        // all the way round. atan(sin, cos) of the difference wraps correctly
        // across the seam without a branch.
        float sp = clamp(spread, 0.0, 1.0);
        if (sp < 0.999 && !isParallel) {
            // rayAngle lives in the flipped, Y-down space this filter borrows
            // from pixi, so subtracting the angle would make 270 degrees point
            // UP. Adding it restores the convention every other control in the
            // kit uses: 90 is up.
            float rel = rayAngle + radians(angle);
            float dA  = abs(atan(sin(rel), cos(rel)));
            float coneHalf = sp * 3.14159265;
            ray *= 1.0 - smoothstep(coneHalf, coneHalf + 0.35, dA);
        }
        mistField = clamp(ray, 0.0, 1.0);
    } else {
    float2 lac = float2(max(lacunarity, 0.0001), clamp(gain, 0.0, 1.0));
    float noise = turbulence(dir + float3(tt, 0.0, 62.1 + tt), float3(480.0, 320.0, 480.0),
                              lac.x, lac.y);
    float bl = max(blur, 0.0);
    if (bl > 0.0) {
        float e = bl * 0.035 * dens;
        float3 dA = float3(d - e, d - e, 0.0) * dens;
        float3 dB = float3(d + e, d + e, 0.0) * dens;
        float nA = turbulence(dA + float3(tt, 0.0, 62.1 + tt), float3(480.0, 320.0, 480.0), lac.x, lac.y);
        float nB = turbulence(dB + float3(tt, 0.0, 62.1 + tt), float3(480.0, 320.0, 480.0), lac.x, lac.y);
        noise = mix(noise, (nA + noise * 2.0 + nB) * 0.25, clamp(bl, 0.0, 1.0));
    }
    noise = mix(noise, 0.0, 0.3);
        mistField = noise;
    }

    // Fades out toward the far edge from the light, same vertical falloff
    // pixi's own filter uses.
    // HENYEY-GREENSTEIN PHASE FUNCTION.
    //
    // Until now this was turbulence times a vertical falloff, with nothing to
    // say how much light scatters in which DIRECTION - so a shaft was as bright
    // looking away from the sun as toward it, which is the opposite of what
    // makes crepuscular rays look like light. Real scattering off droplets and
    // dust is strongly FORWARD-PEAKED: most of the light carries on roughly the
    // way it was already going, so rays blaze when you look near the source and
    // fade quickly as you turn away.
    //
    //   p(t) = (1 - g^2) / (4*pi * (1 + g^2 - 2*g*t)^1.5)
    //
    // with t the cosine of the angle between the view direction and the light,
    // and g the asymmetry: 0 is isotropic, and 0.7-0.9 is the forward peak of
    // real atmospheric haze. Normalised by its own value at t = 1 so the
    // brightest point stays where it was and g only changes the falloff.
    float cosT;
    if (isParallel) {
        cosT = clamp(d, -1.0, 1.0);
    } else {
        float2 lightUV = float2(0.5 + light.x / res.x, 0.5 - light.y / res.y);
        float2 toL = lightUV - uv;
        float dl = length(toL);
        // Screen distance to a real scattering ANGLE. Mapping the frame onto
        // the full 0-180 degrees was wrong by roughly a factor of five: a
        // normal lens sees perhaps 40 degrees corner to corner, so the far
        // corner is about 0.35 radians off the light, not pi. Getting this
        // wrong made the phase function collapse the rays to nothing a short
        // way from the source.
        cosT = cos(clamp(dl * 0.7, 0.0, 3.14159265));
    }
    float g = clamp(scatterG, 0.0, 0.95);
    float gg = g * g;
    float denom = pow(max(1.0 + gg - 2.0 * g * cosT, 1e-4), 1.5);
    float peak  = pow(max(1.0 + gg - 2.0 * g, 1e-4), 1.5);
    float phase = peak / denom;    // 1 straight at the light, falling away

    // The vertical falloff is pixi's, and belongs to the turbulence model: it
    // is what stops parallel shafts filling the frame. The Light Field model
    // has its own falloff - the noise simply decorrelates with radius - so
    // imposing a top-to-bottom bias on it would only fight the cone.
    float mist = mistField * (rayMode > 0.5 ? 1.0 : (1.0 - uv.y)) * phase;

    float3 lin = src.a > 0.0 ? float3(src.rgb / src.a) : float3(0.0);

    // Two colours interleaved along the ANGULAR coordinate, so neighbouring
    // shafts take different colours - that is what reads as dispersion. Keying
    // the ramp off brightness instead would just tint the whole field at once.
    // Both defaults are opaque white, which multiplies out to no change.
    float3 tintA = float3(rayColor.rgb)  * float(rayColor.a);
    float3 tintB = float3(rayColor2.rgb) * float(rayColor2.a);
    float tintFreq = rayMode > 0.5 ? max(rayCount, 0.5) : max(density, 0.001);
    float3 tint  = mix(tintA, tintB,
        clamp(0.5 + 0.5 * sin(rayAngle * tintFreq * 1.7 + 1.3), 0.0, 1.0));

    float3 rayColour  = float3(mist) * tint * clamp(amount, 0.0, 1.0);
    float3 outColour  = clamp(lin + rayColour, 0.0, 1.0);

    // The shafts spread past wherever the source layer had alpha, so alpha
    // has to follow the ray brightness out or it gets clipped to the layer's
    // own shape.
    float rayAlpha = clamp(dot(rayColour, float3(0.3333)), 0.0, 1.0);
    half a = half(clamp(max(float(src.a), rayAlpha), 0.0, 1.0));

    return half4(half3(outColour) * a, a);
}
