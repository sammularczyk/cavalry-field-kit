// GENERATED by src/build.cjs from lightwrapBlur.sksl - do not edit.
// Pass constants baked in so this runs on Cavalry 2.7.2, whose pass
// spec has no `constants` support. Edit the source file instead.
// Lightwrap, blur passes - Field Kit
// Inspired by "bm_Lightwrap" v3.1 by Ben McEwan.
//
// The gizmo takes TWO inputs, a foreground and a background, which a Cavalry
// filter cannot: a filter has one input image. The background therefore comes
// in through a `shaderData` slot - plug the background layer's shader into
// Background Input.
//
// The mechanism, following the gizmo's node order: stencil the background
// against the foreground's alpha so only the background OUTSIDE the foreground
// survives, blur that at a series of increasing radii, then mask the result
// back by the foreground alpha. Light bleeds inward from the edge rather than
// washing over the whole foreground, which is what separates a lightwrap from
// a plain glow.
//
// The first version did the ladder as six sparse spiral gathers in one pass and
// the wrap came out in visible concentric rings: a fixed tap count over a
// growing radius is Monte Carlo estimation, and it quantises. This is the same
// chained-blur identity used by Ultra Glow instead. With H the stencilled
// background and S the running total:
//
//     S(k) = blur(S(k-1)) + H
//
// expands to H + blur(H) + blur²(H) + ... - a sum of progressively wider blurs
// built from real separable 1D passes, with no rings at any size.
//
// The gizmo's Fibonacci/Double ladder choice is gone: the radii now live in the
// pass constants, which are fixed per definition, and Falloff covers the same
// ground by scaling the whole ladder.
//
// The first horizontal blur lives in lightwrapFirst.sksl, because pass 0 cannot
// declare `uniform shader original` - see that file's header.
//
// BACKGROUND ALIGNMENT - the thing that made this filter look broken.
// A `shaderData` input does NOT evaluate in world space. A Noise Shader is
// domain-agnostic so it looks fine either way, but an Image Shader evaluates in
// its SOURCE IMAGE's pixel space measured from a corner - so sampling it at
// world coordinates lands near the image's edge and returns almost nothing. The
// wrap was being computed correctly and fed almost-black.
//
// Hence Background Size and Background Scale: they map world space into the
// background's own pixel space.
//     coord = fragCoord * bgScale + bgSize * 0.5
// bgSize centres the image on the world origin; bgScale accounts for the image
// being displayed at a different size to its native resolution (an image shown
// at half its pixel width needs a scale of 2).
//
// IMPORTANT: shaderData inputs bind BEFORE the input image, which is last.
// Uniform order matches the attribute order in definitions.json.

uniform float  size;
uniform float  falloff;
uniform float  aspect;
uniform float  useLuminance;  // bool: restrict the wrap to bright background
uniform float  threshold;
uniform float2 bgSize;
uniform float2 bgScale;

const float dirX = 1.000000;   // baked from the pass constant
const float dirY = 0.000000;   // baked from the pass constant
const float radiusMul = 1.000000;   // baked from the pass constant
const float addH = 0.000000;   // baked from the pass constant

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader background;    // shaderData attribute - binds BEFORE the image
uniform shader childShader;   // pass 1: the foreground. Later: previous pass.
uniform shader original;      // the foreground - MUST be declared last

const int TAPS = 8;           // 17 samples per axis, per pass

// World space -> the background shader's own coordinate space. See the header.
float2 bgCoord(float2 fragCoord) {
    return fragCoord * float2(max(bgScale.x, 0.0001), max(bgScale.y, 0.0001))
         + bgSize * 0.5;
}

// Background with the foreground stencilled out, so only light from OUTSIDE the
// foreground can wrap inward. The foreground alpha comes from whichever input
// still holds the untouched layer at this point in the chain.
float3 stencilled(float2 coord) {
    half4 bg = background.eval(bgCoord(coord));
    // Guarded divide, NOT a ternary. An unconnected shaderData input is
    // substituted as a constant half4(0), and SkSL constant-folds BOTH arms
    // of a ternary at compile time - so `a > 0 ? rgb / a : rgb` becomes 0/0
    // and the whole shader fails to compile with "division by zero". The
    // guard never runs. max() cannot fold to zero, so it is always safe.
    float3 lin = float3(bg.rgb) / max(float(bg.a), 1e-6);

    half4 fg = original.eval(coord);
    lin *= 1.0 - clamp(float(fg.a), 0.0, 1.0);

    if (useLuminance > 0.5) {
        // Only the brighter parts of the background emit, as the gizmo's
        // luminance keyer does.
        float lum = dot(lin, float3(0.299, 0.587, 0.114));
        lin *= smoothstep(threshold, 1.0, lum);
    }
    return lin;
}

half4 main(float2 fragCoord) {
    float r = max(size, 0.0) * radiusMul / max(falloff, 0.0001);
    // Aspect stretches the horizontal pass only, which is where it belongs.
    float2 dir = float2(dirX * max(aspect, 0.01), dirY);

    float3 sum = float3(0.0);
    float  den = 0.0;

    for (int i = -TAPS; i <= TAPS; i++) {
        float f = float(i) / float(TAPS);
        float w = exp(-2.0 * f * f);
        float2 at = fragCoord + dir * (f * r);
        half4 c = childShader.eval(at);
        float3 v = c.a > 0.0 ? float3(c.rgb / c.a) : float3(c.rgb);
        sum += v * w;
        den += w;
    }

    float3 outRgb = sum / max(den, 0.0001);

    // Feed H back in on the vertical pass, which is what makes the chain sum
    // the whole ladder of widths rather than just blurring once.
    if (addH > 0.5) {
        outRgb += stencilled(fragCoord);
    }

    return half4(half3(clamp(outRgb, 0.0, 64.0)), half(1.0));
}
