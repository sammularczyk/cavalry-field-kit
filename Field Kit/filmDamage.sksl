// Film Damage - Field Kit
// Split out of Film Emulation: grain, halation and tone are properties of the
// EMULSION, while everything here happens to a finished print running through
// a projector - a different object at a different point in the chain. Stack
// this after Film Emulation and the order is physically right: grain sits in
// the negative, damage sits on the print over it.
// Gate weave, stepped frame rate, an exposure-responsive grain/dirt layer,
// scratches, splotch-scale dirt, a flickering vignette and a flickering
// exposure - the wear of a hand-cranked projector print.
//
// Grain and dirt model inspired by "Cinematic Grain"
// (github.com/max-van-leeuwen/SnapLensStudio-GrainGenerator), MIT licence,
// Max van Leeuwen. That repository ships only a compiled Lens Studio material
// (a binary .lsmat) with no readable shader source, so there is nothing in it
// to port line-for-line; what carries over is the idea its README and preview
// describe - grain whose visible strength tracks the image's own exposure,
// rather than a uniform noise field laid over everything at one constant
// strength.
//
// The blob-shaped dirt above already plays the role tao-film-strip's
// "splotches" would - a coarse, thresholded noise field re-shuffled a few
// times a second gives multiple simultaneous irregular blemishes of varying
// size, which is what a splotch is. A second, near-duplicate control for the
// same visual idea was judged not worth adding.
//
// Scratches are new, and modelled on a film-damage synthesis paper's
// description rather than tao-film-strip's (GPL-3.0) cruder sin()-indexed
// line, which the paper's own geometry supersedes: a sinc^2-Gaussian hybrid
// profile (the Fraunhofer diffraction pattern of a narrow slit), width
// varying along the scratch's length, per-frame intensity flicker, a slowly
// drifting (not mean-reverting) lateral position, and a 70/30 bright/dark
// polarity split (emulsion abrasion vs surface contamination). A fixed-size
// loop with per-index hashes stands in for the paper's independent random
// lifetimes, since a shader cannot keep a persistent scratch registry across
// frames.
//
// Gate weave models an Ornstein-Uhlenbeck process from the same paper:
// temporally correlated and mean-reverting rather than a slow float. Bounded
// low-frequency noise already reverts to its mean by construction, which
// covers the first-order (horizontal) case; the paper's detail that matters is
// that VERTICAL weave is second-order - its own mean-reversion strength
// drifts over time - approximated here by modulating the vertical wander's
// amplitude with a much slower second noise, so it alternates between calmer
// and jitterier stretches instead of one constant character throughout.
//
// Exposure flicker uses the paper's log-normal distribution
// (exp(N(0, 0.125)), clamped) in place of a uniform random wobble - real lamp/
// shutter flicker is multiplicative and skewed, not symmetric.
//
// `damageDomain` follows the paper's negative-vs-positive distinction: capture
// -stage corruption (here: dirt, scratches, vignette, flicker) happens to the
// NEGATIVE, so applying it in the inverted domain (1-x, processed, 1-result)
// changes how it distributes between highlights and shadows - cheap, and
// physically grounded, so it is exposed as a control rather than assumed.
//
// Every formula here - the weave wander, the frame-locked flicker, the
// vignette falloff, the exposure response curve, the scratch profile - is
// this filter's own implementation of the ideas above; none of it is a line-
// for-line port.
//
// Uniform order matches the attribute order in definitions.json.

uniform float  damage;          // master: 0 = pristine print
uniform float  damageDomain;    // enum: 0 positive print, 1 negative (inverted processing)
uniform float  time;            // auto-connected to comp time, in SECONDS
uniform float  speed;           // playback-rate multiplier for the damage clock (1 = real time)
uniform float  frameRate;       // steps the clock to this rate, 0 = smooth

uniform float  weave;           // gate weave / image wobble
uniform float  dirt;            // grain + dirt/scratch density
uniform float  dirtThreshold;
uniform float  dirtScale;
uniform float  dirtPolarity;    // -1 print dirt (black), +1 negative dirt (bright)
uniform float  scratches;       // scratch density/amount
uniform float  scratchWidth;    // base scratch width, pixels
uniform float  flicker;         // exposure flicker
uniform float  gateRounding;    // 1 = elliptical gate, 0 = square-cornered
uniform float  gateSoftness;    // how far the gate edge feathers
uniform float  vignetteAmount;
uniform float  vignetteFlicker;

uniform float  desaturate;
uniform float  dyeFade;         // cyan dye dies first, so prints go magenta
uniform float  hotSpot;         // lamp is brighter in the centre
uniform float  scratchPolarity; // -1 base side (dark), +1 emulsion side (bright)
uniform float  shutterBlades;   // 0 off, else 2 or 3 blades
uniform float  splice;          // jolt at a physical join
uniform float  spliceInterval;  // seconds between joins
uniform float  cueMarks;        // reel-changeover cue in the top-right
uniform float  cueInterval;     // seconds between cues; 0 pins them on
uniform float  hair;            // hair caught in the gate
uniform float  hairSeed;        // which hair, and where it sits      // 1 = full black and white
uniform float  amount;

uniform float2 resolution;
uniform float2 rectCentre;

// Single pass, so childShader IS the layer. Pass 0 must NOT declare
// `original` - there is no such input and the shader fails to BUILD.
uniform shader childShader;     // pass 0 input = the layer being filtered

const float PI = 3.14159265359;

// Ubiquitous IQ-style hashes - the generic building blocks behind every noise
// field below, not specific to any one shader.
float hash21(float2 p) {
    p = fract(p * float2(0.1031, 0.11369));
    p += dot(p, p.yx + 19.19);
    return fract((p.x + p.y) * p.x);
}

float hash1(float n) {
    return fract(sin(n) * 43758.5453123);
}

// Smooth value noise.
float vnoise(float2 p) {
    float2 i = floor(p), f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i),                   hash21(i + float2(1.0, 0.0)), u.x),
               mix(hash21(i + float2(0.0, 1.0)), hash21(i + float2(1.0, 1.0)), u.x), u.y);
}

// Box-Muller from two hashes - a real Gaussian sample for the log-normal
// flicker below, rather than a uniform one.
float gauss1(float n) {
    float u1 = max(hash1(n), 1e-6);
    float u2 = hash1(n + 91.7);
    return sqrt(-2.0 * log(u1)) * cos(2.0 * PI * u2);
}

// First-order OU approximation: bounded, temporally correlated low-frequency
// wander. Bounded noise reverts to its mean by construction, which is the
// property that matters - it does not need a literal recurrence relation.
// Gate weave as an Ornstein-Uhlenbeck wander, approximated by fBm.
//
// A mean-reverting random walk has a 1/f^2 power spectrum, so amplitude has to
// HALVE as frequency doubles. The previous version summed two octaves at full
// amplitude - which is not a wander at all, it is two overlapping wobbles, and
// at the default Speed the clock crosses only about two cells of noise across a
// hundred frames. The result was a figure-of-eight repeating on a short cycle,
// which is exactly what a real gate does not do.
//
// Five octaves at a NON-INTEGER lacunarity: 2.17 rather than 2.0, so the
// octaves never line up on a common period and the motion has no beat. `sum`
// accumulates real noise samples at runtime coordinates, so it cannot fold to
// a constant the way a literal-only loop would.
float ouWander(float t, float seedY) {
    float sum = 0.0, amp = 1.0, f = 1.0, norm = 0.0;
    for (int i = 0; i < 5; i++) {
        sum  += amp * (vnoise(float2(t * f, seedY + float(i) * 13.7)) - 0.5);
        norm += amp;
        amp  *= 0.5;
        f    *= 2.17;
    }
    return sum / max(norm, 1e-4) * 2.0;
}

float ouHoriz(float t) { return ouWander(t, 11.7); }

// Vertical weave is second-order - the sprockets drive it, so its amplitude
// itself drifts over a much longer period than the wander does.
float ouVert(float t) {
    float amp = 0.4 + 1.2 * (0.5 + 0.5 * vnoise(float2(t * 0.07 + 91.3, 4.2)));
    return ouWander(t + 8.3, 27.4) * amp;
}

float2 wanderNoise(float t) { return float2(ouHoriz(t), ouVert(t)); }

// Exposure response: how strongly grain and dirt show against a given
// luminance. Rises steeply out of black, peaks in the mid-shadows (lum = 1/3)
// and falls away again toward white, normalised so the peak reads 1.0. This
// is what makes the effect react to the picture instead of sitting uniformly
// over the top of it.
float exposureResponse(float lum) {
    float l = clamp(lum, 0.0, 1.0);
    return sqrt(l) * (1.0 - l) * 2.598076;
}

// Combined grain + dirt multiplier, both gated by exposureResponse.
//   - Grain: a fine per-pixel field, re-seeded every quantised frame.
//   - Dirt: a much coarser field thresholded into sparse dark specks,
//     re-shuffled a few times a second since real specks sit still on the
//     gate for many frames rather than reshuffling every one. This is also
//     what stands in for "splotches" - see the header.
float filmDamageMul(float2 px, float t, float lum) {
    float amt = clamp(dirt, 0.0, 1.0);
    if (amt <= 0.0) { return 1.0; }

    float resp = exposureResponse(lum);
    float scale = max(dirtScale, 0.001);

    // Both the grain re-seed and the dirt reshuffle step on PROJECTOR frames.
    // They were hardcoded at 24 and 4 times a second, so neither tracked Frame
    // Rate - the dirt kept its own cadence no matter what the projector was set
    // to, which is exactly what it looked like. `t` is already quantised to the
    // projector rate, so multiplying it back up recovers the frame index.
    float fr = frameRate > 0.0 ? frameRate : 24.0;
    float frameIdx = floor(t * fr + 0.5);

    float2 cell = floor(px / scale);
    float g = hash21(cell + frameIdx * float2(17.31, 9.13)) - 0.5;

    // DIRT AS PARTICLES, not a thresholded cloud.
    //
    // Thresholding an fBm field gave every speck roughly the same size, because
    // a band of a noise field only contains features at that band's scale. Real
    // dust is nothing like that: its sizes follow a power law - overwhelmingly
    // tiny specks with an occasional large one - and that distribution is the
    // whole visual signature. r = rmin * u^-0.45 draws from it directly.
    //
    // Particles are Poisson-placed one per cell, the same construction the
    // grain uses, so there is no lattice however coarse the scale gets. The
    // outline is perturbed by angle because a dust flake or a fibre is not a
    // disc, and a circular speck reads as a drawn dot.
    float2 pos  = px / (scale * 40.0);
    float2 base = floor(pos);
    float dens  = clamp(dirtThreshold, 0.0, 1.0);
    float speck = 0.0;
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            float2 cell = base + float2(float(i), float(j));
            float2 fs = cell + frameIdx * float2(17.31, 9.13);
            // Most cells are empty; skipping them early is what keeps this
            // cheaper than the field it replaces.
            if (hash21(fs) > dens) { continue; }
            float u = clamp(hash1(dot(cell, float2(3.1, 7.7)) + frameIdx * 0.37), 1e-3, 1.0);
            float r = min(0.02 * pow(u, -0.45), 0.42);
            float2 c = cell + float2(hash1(dot(fs, float2(1.7, 9.2))),
                                     hash1(dot(fs, float2(5.3, 2.1)) + 11.0));
            float2 dv = pos - c;
            // Low harmonics, small amplitude: a dust flake is a lumpy blob,
            // not a star. Driving 5 and 11 lobes at +-55% made every speck a
            // five-pointed star - high harmonics at high amplitude are spikes,
            // and irregularity lives in the LOW ones.
            float ang = atan(dv.y, dv.x);
            float rr = r * (1.0 + 0.16 * sin(ang * 2.0 + u * 19.0)
                                + 0.09 * sin(ang * 3.0 - u * 7.0));
            speck = max(speck, 1.0 - smoothstep(rr * 0.7, rr, length(dv)));
        }
    }

    // Polarity. Dust on the print or in the gate blocks light and reads BLACK.
    // Dust on the NEGATIVE blocks exposure instead, so that spot stays clear on
    // the print and projects BRIGHT - the white sparkle of an archive print,
    // which a darken-only model cannot produce at all.
    float dpol = clamp(dirtPolarity, -1.0, 1.0);
    float bright = speck * clamp(0.5 + 0.5 * dpol, 0.0, 1.0);
    float dark   = speck * clamp(0.5 - 0.5 * dpol, 0.0, 1.0);
    float speckDarken = 1.0 - dark * 0.85;

    float mul = 1.0 + g * 0.5 * resp;
    mul *= mix(1.0, speckDarken, resp);
    mul += bright * 0.9 * mix(1.0, resp, 0.5);

    return mix(1.0, mul, amt);
}

// Radial corner darkening, breathing gently with a frame-locked flicker.
float vignetteAt(float2 uv, float t) {
    // The GATE, as a superellipse. A projector aperture is a rectangle with
    // rounded corners, and the light falls off through it - a plain circular
    // vignette gets the corners wrong, and a rounded rectangle has a curvature
    // break where its arcs meet its straight edges. |x|^n + |y|^n = 1 has no
    // such joint, which is why Display Simulation uses the same shape for its
    // faceplate. Rounding drives the exponent: 1 is a true ellipse, and small
    // values approach a hard-cornered rectangle.
    float2 p = (uv - 0.5) * 2.0;
    float n = clamp(1.0 / max(gateRounding * 0.5, 0.015), 2.0, 64.0);
    float rad = pow(pow(abs(p.x), n) + pow(abs(p.y), n), 1.0 / n);

    float e = max(gateSoftness, 0.001);
    float vig = 1.0 - smoothstep(1.0 - e, 1.0 + e, rad);

    float fl = hash1(floor(t * 10.0) * 5.37) - 0.5;
    vig = clamp(vig + fl * 0.08 * vignetteFlicker, 0.0, 1.0);

    return mix(1.0, vig, clamp(vignetteAmount, 0.0, 1.0));
}


// Normalised sinc, with the x=0 singularity handled.
float sincN(float x) {
    float ax = abs(x);
    if (ax < 1e-4) { return 1.0; }
    float px = PI * x;
    return sin(px) / px;
}

// One scratch's contribution at this pixel. `secs` is the damage pass's clock
// in SECONDS, so scratch timing shares it with everything
// else rather than the paper's hard-coded speed constants.
// Returns (mask, isBright) packed as mask in .x and a 0/1 bright flag in .y.
float2 scratchAt(int idx, float2 px, float secs) {
    float seedI = float(idx) * 91.7 + 3.1;

    // 20-70 "frame" lifespan, respawning into a fresh instance each cycle -
    // the fixed-loop, per-index-hash stand-in for independent random
    // lifetimes, since there is no persistent state across frames to draw on.
    // In SECONDS, not in the stepped projector clock. That clock advances
    // frameRate/compFps per rendered frame - about 0.4 - so a nominal
    // "20 to 70 frames" of life was really 50 to 175 frames, two to six
    // seconds, which is why scratches outstayed their welcome. Seconds are
    // also frameRate-independent, so changing the projector rate no longer
    // silently changes how long a scratch lives.
    float lifespan = mix(0.7, 2.3, hash1(seedI));
    float gen       = floor(secs / lifespan);
    float instSeed  = seedI + gen * 13.1;

    // Respawn chance: not every generation actually spawns an instance, which
    // is what keeps the average count nearer 3-4 of the fixed 5 slots than a
    // constant 5.
    if (hash1(instSeed * 3.7) > 0.82) { return float2(0.0, 0.0); }

    float age      = mod(secs, lifespan);
    float lifeFrac = clamp(age / lifespan, 0.0, 1.0);
    float envelope = smoothstep(0.0, 0.08, lifeFrac) * smoothstep(1.0, 0.92, lifeFrac);

    // Base width 1-4px (real scratches are THIN), varying along the length by
    // summed low-frequency noise - an approximation of the paper's cumulative
    // random walk, since a true running sum needs per-frame state this filter
    // does not have.
    float baseWidth = mix(1.0, 4.0, hash1(instSeed * 5.9)) * max(scratchWidth, 0.001) * 0.5;
    float walk = vnoise(float2(px.y * 0.02, instSeed)) * 0.7
               + vnoise(float2(px.y * 0.08, instSeed + 5.0)) * 0.3;
    float w = max(baseWidth * (0.6 + 0.8 * walk), 0.25);

    // Lateral position: a slow, PERIODIC drift, not mean-reverting like gate
    // weave - a fixed projector defect wandering back and forth, not settling.
    float freq1 = mix(0.02, 0.05, hash1(instSeed * 2.1));
    float freq2 = mix(0.005, 0.015, hash1(instSeed * 4.4));
    float phase1 = hash1(instSeed * 6.6) * 6.28318530718;
    float phase2 = hash1(instSeed * 8.8) * 6.28318530718;
    float driftX = sin(secs * freq1 + phase1) * 6.0 + sin(secs * freq2 + phase2) * 3.0;
    float baseX = mix(-0.5, 0.5, hash1(instSeed)) * resolution.x;

    float dx = (px.x - baseX - driftX) / w;
    float sinc = sincN(dx);
    float k = sinc * sinc * exp(-(dx * dx * w * w) / (2.0 * pow(1.5 * w, 2.0)));

    // Per-frame intensity flicker, +/-20%.
    float flick = 1.0 + (hash1(instSeed * 7.0 + floor(secs * 24.0)) - 0.5) * 0.4;

    float mask = clamp(k * envelope * flick, 0.0, 1.0);

    // Polarity: 70% bright (emulsion abrasion), 30% dark (surface contamination).
    float bright = hash1(instSeed * 5.3) < 0.7 ? 1.0 : 0.0;

    return float2(mask, bright);
}

const int MAX_SCRATCHES = 5;

// Combined scratch contribution: strongest bright hit and strongest dark hit
// across the fixed loop, so overlapping scratches do not stack into a solid
// bar.
float2 scratchesAt(float2 px, float secs) {
    float bright = 0.0;
    float dark = 0.0;
    for (int i = 0; i < MAX_SCRATCHES; i++) {
        float2 s = scratchAt(i, px, secs);
        if (s.y > 0.5) { bright = max(bright, s.x); } else { dark = max(dark, s.x); }
    }
    float amt = clamp(scratches, 0.0, 1.0);
    return float2(bright, dark) * amt;
}

// Reel-changeover cue - the "cigarette burn". Two 4-frame marks punched into
// the top-right corner of the print so the projectionist knows to start the
// second machine. Interval 0 pins it on permanently, for when you want the
// mark rather than the schedule.
float cueMarkAt(float2 uv, float t, float aspect) {
    if (cueMarks <= 0.0) { return 0.0; }
    // TWO cues, eight frames apart: the motor cue to start the incoming
    // projector, then the changeover cue to swap. Four frames each.
    if (cueInterval > 0.0) {
        float ph = fract(t / cueInterval) * cueInterval;   // seconds into the cycle
        bool first  = ph <= 0.1667;                        // ~4 frames at 24
        bool second = ph >= 0.3333 && ph <= 0.5;           // 8 frames later
        if (!first && !second) { return 0.0; }
    }
    float2 p = (uv - float2(0.90, 0.88)) * float2(aspect, 1.0);
    // A CIRCLE. Cue marks were scribed against a template, not freehand, so
    // they are clean - the previous attempt at a "ragged" edge used a 7-lobe
    // harmonic that simply turned it into a seven-pointed star. The only
    // irregularity worth having is a slightly soft edge, from the scribe not
    // cutting to a uniform depth.
    float rr = 0.023;
    return (1.0 - smoothstep(rr * 0.82, rr * 1.04, length(p))) * clamp(cueMarks, 0.0, 1.0);
}


// A hair caught in the gate: rooted at the frame edge, twitching with the
// film's movement. Its root drifts every few seconds so it reads as something
// caught in the machine rather than a drawn line.
float hairAt(float2 uv, float t, float aspect) {
    if (hair <= 0.0 || uv.y > 0.32) { return 0.0; }
    // A hair in the gate is STUCK there. It holds its position and its shape
    // until someone cleans the machine - all it does is tremble as the film
    // drags past. The first version swept it with sin(y*34 + t*6), which made
    // it swim across the frame like a worm; that motion was invented, not
    // observed. The shape is now fixed by a seed and only jitters by a
    // fraction of a pixel per frame.
    float root  = 0.15 + 0.7 * hash1(hairSeed * 7.7);
    float curve = sin(uv.y * 9.0 + hairSeed * 2.3) * 0.03
                + sin(uv.y * 21.0 + hairSeed * 5.1) * 0.012;
    float tremble = (hash1(floor(t * 24.0) * 1.7 + hairSeed) - 0.5) * 0.0015;
    float x = root + curve * (uv.y / 0.32) + tremble;
    float dx = abs(uv.x - x) * aspect;
    float taper = 1.0 - smoothstep(0.0, 0.32, uv.y);
    return (1.0 - smoothstep(0.0015, 0.0035, dx)) * taper * clamp(hair, 0.0, 1.0);
}


half4 main(float2 fragCoord) {
    half4 orig = childShader.eval(fragCoord);
    float dmg = clamp(damage, 0.0, 1.0);
    // Every effect below is gated on dmg, so zero is an exact passthrough -
    // worth taking early rather than running the whole projector for nothing.
    if (dmg <= 0.0) { return orig; }

    float2 res = max(resolution, float2(1.0));

    // `time` is the composition's time in FRAMES, so `speed` converts it to
    // seconds - at its 0.0333 default that is 1/30, i.e. a 30 fps comp. This
    // was briefly "corrected" to seconds on the assumption that compConnect
    // hands over seconds; it does not. A scene saved at frame 1159 of a
    // 1200-frame, 30 fps comp records time = 1159, and seconds would have
    // capped at 40.
    //
    // So frameRate's stepping is real but subtle rather than absent: at 12 the
    // clock advances every 2.5 frames, which on slow-moving damage is easy to
    // miss. If it still reads as doing nothing, the honest fix is to make the
    // artefacts it drives more obviously frame-locked, not to rescale time.
    float secs = time * speed;
    float t = frameRate > 0.0 ? floor(secs * frameRate) / frameRate : secs;

    // Gate weave: an Ornstein-Uhlenbeck-style wander - see ouHoriz/ouVert.
    // A physical join every few hundred feet: the print jolts vertically and
    // the density pops for a frame or two as the splice passes the gate.
    float spliceHit = 0.0;
    if (splice > 0.0 && spliceInterval > 0.0) {
        float ph = fract(t / spliceInterval);
        if (ph <= 0.0833 / spliceInterval) { spliceHit = clamp(splice, 0.0, 1.0); }
    }

    float2 off = dmg * weave * wanderNoise(t * 0.6);
    off.y += dmg * spliceHit * 0.02;

    float2 uv = (fragCoord - rectCentre) / res + 0.5 + off;
    // The weave moves the whole frame, so without this a transparent band
    // tracks around the edge on every frame. A real gate would show the frame
    // line there, but nothing compositing this wants a hole - and the wander is
    // a few pixels at most, so clamping smears a rim too thin to see. No
    // control for it: transparent is never the wanted answer here.
    uv = clamp(uv, 0.5 / res, 1.0 - 0.5 / res);
    half4 c = childShader.eval((uv - 0.5) * res + rectCentre);

    float3 lin = c.a > 0.0 ? float3(c.rgb / c.a) : float3(0.0);
    float lum = dot(lin, float3(0.2126, 0.7152, 0.0722));

    // Grain and dirt work in layer-local pixels, so their feature size is
    // predictable and independent of the layer's aspect ratio.
    float2 px = fragCoord - rectCentre;

    float d = filmDamageMul(px, t, lum);
    // Screen-space, NOT the weaved uv. The gate and the lens belong to the
    // machine and do not move; the film wanders behind them. Feeding this the
    // weaved coordinate dragged the whole vignette around with the frame, which
    // read as black edges swinging in and out as Weave went up.
    float v = vignetteAt((fragCoord - rectCentre) / res + 0.5, t);
    float2 scratch = scratchesAt(px, secs);   // x = bright mask, y = dark mask

    // Exposure flicker: log-normal (paper's exp(N(0, 0.125))) rather than a
    // uniform wobble - real lamp/shutter flicker is multiplicative and skewed,
    // not symmetric about 1. `flicker` scales the underlying Gaussian's sigma,
    // so 0 gives exp(0) = 1 exactly.
    float fSeed = floor(t * 24.0);
    float f = clamp(exp(0.125 * gauss1(fSeed * 3.71) * clamp(flicker, 0.0, 4.0)), 0.2, 4.0);

    d = mix(1.0, d, dmg);
    v = mix(1.0, v, dmg);
    f = mix(1.0, f, dmg);
    // Base-side scratches ride on the shiny side and read DARK; emulsion-side
    // scratches gouge the dyes away and read bright. scratchesAt returns both,
    // so polarity is a bias between them rather than a second scratch system.
    float pol = clamp(scratchPolarity, -1.0, 1.0);
    scratch *= float2(1.0 + pol, 1.0 - pol);
    scratch *= dmg;

    // Shutter blades chop the light ABOVE frame rate, so they cannot show as
    // flicker in a per-frame render. What is visible - and what a camera
    // pointed at a screen actually records - is the BEAT between blade rate and
    // capture rate, so that is what this models.
    if (shutterBlades > 0.0) {
        f *= 1.0 + 0.06 * dmg * cos(6.28318530718 * shutterBlades * max(frameRate, 1.0) * secs);
    }
    f *= 1.0 + spliceHit * dmg * 0.5;

    // The lamp is brighter on the optical axis, which is the opposite gradient
    // to the gate vignette and not cancelled by it.
    float hr = clamp(length((fragCoord - rectCentre) / res) * 2.0, 0.0, 1.0);
    v *= 1.0 + dmg * clamp(hotSpot, 0.0, 2.0) * (1.0 - hr * hr);

    // Negative-domain processing: capture-stage corruption happens on the
    // negative, not the print. Working in 1-x changes how dirt, scratches,
    // vignette and flicker distribute between highlights and shadows -
    // shadows in the positive are highlights on the negative, and vice versa.
    bool negDomain = damageDomain > 0.5;
    float3 work = negDomain ? (1.0 - lin) : lin;
    work = work * d * v * f;
    work = clamp(work * (1.0 - scratch.y * 0.8) + scratch.x * 0.9, 0.0, 4.0);
    float3 col = negDomain ? clamp(1.0 - work, 0.0, 1.0) : clamp(work, 0.0, 1.0);

    float lum2 = dot(col, float3(0.299, 0.587, 0.114));
    col = mix(col, float3(lum2), clamp(desaturate, 0.0, 1.0) * dmg);
    // Dye fade. Cyan is the least stable dye and goes first, magenta next,
    // yellow last - losing cyan means less red is absorbed, which is exactly
    // why old prints drift magenta-red rather than simply desaturating.
    float fd = clamp(dyeFade, 0.0, 1.0) * dmg;
    if (fd > 0.0) {
        float3 dens = -log(max(col, float3(1e-4)));
        dens *= float3(1.0 - 0.80 * fd, 1.0 - 0.45 * fd, 1.0 - 0.15 * fd);
        col = exp(-dens);
    }

    float2 suv = (fragCoord - rectCentre) / res + 0.5;
    float asp = res.x / max(res.y, 1.0);
    col *= 1.0 - hairAt(suv, t, asp) * dmg;
    col += cueMarkAt(suv, t, asp) * dmg * 0.9;

    col = clamp(col, 0.0, 1.0);

    half a = c.a;
    return mix(orig, half4(half3(col) * a, a), half(clamp(amount, 0.0, 1.0)));
}
