// GENERATED by src/build.cjs from filmHalationBlur.sksl - do not edit.
// Pass constants baked in so this runs on Cavalry 2.7.2, whose pass
// spec has no `constants` support. Edit the source file instead.
// Film: halation, passes 1 and 2 of 2 - Field Kit
// Replaces the old single-pass spiral gather, which blurred the WHOLE image
// and mixed the blur back in with `mix()` - wrong on three counts: it softened
// everything instead of glowing around highlights, mix() is an opacity blend
// where light accumulation wants to be additive, and a fixed-tap spiral over a
// growing radius is Monte Carlo estimation, which rings.
//
// The physically-motivated recipe instead: isolate the highlights with a soft
// luminance threshold, densify and tint them, blur that matte SEPARABLY
// (horizontal then vertical - O(N) rather than O(N^2)), then screen the result
// back onto the Colour Recipe's own output.
//
// One file does both passes, like filmClarityBlur.sksl - `dirX`/`dirY`/
// `lastPass` come from the pass constants.
//
// CHANNEL BUDGET, i.e. why this needs exactly two passes and not three or four.
// A pass only ever sees its immediate predecessor's output (`childShader`) plus
// the untouched filter input (`original`) - never anything further back. The
// matte has to be blurred over two passes, but the colour to screen it onto
// (the Colour Recipe's output) is needed again in the SECOND of those passes,
// two steps after it was last directly available. There is no third channel to
// carry a second image through, so:
//   - Pass 1 (lastPass = 0) isolates the matte inline, per horizontal tap, from
//     `childShader` (the Recipe's real output) exactly as filmClarityBlur.sksl
//     does its inline luminance calc - no separate isolate pass needed. It
//     re-samples the Recipe colour ONCE at the centre pixel (no offset, so it
//     stays sharp) and hands it on in RGB, unpremultiplied. The horizontally-
//     blurred matte weight (always 0..1, so it never needs the alpha channel's
//     usual range) rides in ALPHA instead of true alpha.
//   - Pass 2 (lastPass = 1) reads that scratch buffer, finishes the blur
//     vertically by gathering the weight out of alpha, and gets the Recipe
//     colour back by re-sampling RGB at the centre pixel again - pass 1 carried
//     it through untouched, so it is still exactly right.
//   - True alpha is recovered from `original` at combine time. Nothing in this
//     filter's colour grading changes coverage, so the untouched input's alpha
//     is still valid this many passes downstream.
//
// DENSITY BEFORE TINT, not after as the brief describes it. Tinting first would
// mean raising a coloured value to a power, which crushes whichever channel is
// already smallest (typically blue, for a warm tint) toward zero rather than
// densifying it - and it would need three scratch channels through the blur
// instead of one, which the channel budget above does not have. Applying the
// density power to the plain scalar weight, then tinting once at combine time,
// gives the same "core denser than the falloff" result without either problem.

uniform float  halation;
uniform float  halationRadius;
uniform float  halationThreshold;
uniform float  halationDensity;
uniform float  halationRing;    // hollows the core into a standing fringe
uniform half4  halationTint;

const float dirX = 0.000000;   // baked from the pass constant
const float dirY = 1.000000;   // baked from the pass constant
const float lastPass = 1.000000;   // baked from the pass constant

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader childShader;   // pass 1: Colour Recipe's output. pass 2: pass 1's scratch buffer.
uniform shader original;      // untouched input - MUST be declared last

const int TAPS = 14;

// Fixed smoothstep width for the threshold - the control that matters is WHERE
// it sits (halationThreshold), not how soft the knee is.
const float EDGE = 0.12;

// Isolated highlight weight from a real (premultiplied) colour sample: a soft
// luminance threshold, densified by a power so the core reads much denser than
// the falloff, and scaled by the master Halation amount so 0 is an EXACT
// passthrough further downstream - the weight carries that guarantee rather
// than a branch.
float matteAt(half4 c) {
    float3 lin = c.a > 0.0 ? float3(c.rgb / c.a) : float3(0.0);
    float y = dot(lin, float3(0.2126, 0.7152, 0.0722));
    float w = smoothstep(halationThreshold - EDGE, halationThreshold + EDGE, y);
    w = pow(clamp(w, 0.0, 1.0), max(halationDensity, 1.0));
    return w * clamp(halation, 0.0, 1.0);
}

half4 main(float2 fragCoord) {
    // Exact passthrough at 0: pass 1 forwards the real image untouched, so
    // pass 2 (which also takes this branch) forwards that same real image.
    if (halation <= 0.0 || halationRadius <= 0.0) { return childShader.eval(fragCoord); }

    bool vertical = lastPass > 0.5;
    float2 dir = float2(dirX, dirY);

    float sum = 0.0;
    float den = 0.0;
    for (int i = -TAPS; i <= TAPS; i++) {
        float f = float(i) / float(TAPS);
        float w = exp(-f * f * 2.0);
        half4 c = childShader.eval(fragCoord + dir * (f * halationRadius));
        float tap = vertical ? float(c.a) : matteAt(c);
        sum += tap * w;
        den += w;
    }
    float weight = clamp(sum / max(den, 0.0001), 0.0, 1.0);

    // The Recipe colour, carried through pass 1 untouched - see header.
    half4 centre = childShader.eval(fragCoord);
    if (!vertical) {
        float3 lin = centre.a > 0.0 ? float3(centre.rgb / centre.a) : float3(0.0);
        return half4(half3(clamp(lin, 0.0, 1.0)), half(weight));
    }

    float3 lin = float3(centre.rgb);   // pass 1's passthrough, already unpremultiplied

    // THE RING. Halation is light that crosses the emulsion, reflects off the
    // base, and re-exposes the emulsion A FIXED DISTANCE AWAY - that distance
    // set by the base thickness and the angle of total internal reflection. So
    // the point spread function has a characteristic RADIUS: a fringe standing
    // off the highlight, not a monotonic falloff from zero. A plain Gaussian
    // has its maximum at the source, which is a glow, and glow is what it
    // looked like.
    //
    // Subtracting a narrow gather from the wide one is a difference of
    // Gaussians, which is the standard separable stand-in for an annulus. The
    // narrow term has to be a real 2D gather rather than another separable
    // pass, because only ONE scalar crosses the pass boundary (see the channel
    // budget above) - but pass 1 carried the Recipe colour through in RGB, so
    // the raw matte can simply be recomputed here. It is cheap: the inner
    // radius is small by definition, so a handful of taps covers it.
    float ring = clamp(halationRing, 0.0, 1.0);
    if (ring > 0.0) {
        float inner = 0.0, iden = 0.0;
        for (int j = -2; j <= 2; j++) {
            for (int i = -2; i <= 2; i++) {
                float2 o = float2(float(i), float(j)) * (halationRadius * 0.22);
                float wq = exp(-dot(o, o) / max(halationRadius * halationRadius * 0.15, 1e-4));
                inner += matteAt(childShader.eval(fragCoord + o)) * wq;
                iden  += wq;
            }
        }
        weight = clamp(weight - ring * 0.85 * (inner / max(iden, 1e-4)), 0.0, 1.0);
    }

    // Light ADDS. Screen is a saturating approximation to addition that quietly
    // compresses the fringe just where it is brightest, which is the part worth
    // seeing; halation is real light landing on the emulsion, so it accumulates.
    float3 glow = float3(halationTint.rgb) * weight;
    float3 outCol = clamp(lin + glow, 0.0, 1.0);

    half4 orig = original.eval(fragCoord);
    half a = orig.a;
    return half4(half3(outCol) * a, a);
}
