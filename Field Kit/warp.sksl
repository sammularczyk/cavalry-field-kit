// Warp - Field Kit  (thirdPartyShader: a generator)
//
// Ported from paper-design/shaders `warp.ts` (Apache-2.0, Lost Coast Labs).
// Changes: SkSL port; their texture-backed value noise becomes a procedural
// hash; fwidth is replaced with an analytic pixel estimate; the colour array is
// unrolled to four stops (SkSL forbids dynamic array indexing); Speed is
// remapped so 1.0 matches upstream's own Speed 1.
//
// THE SWIRL IS THE WHOLE SHADER, AND THREE DETAILS MAKE IT WORK.
//
// 1. The working UV spans roughly +-0.25 of the frame. Upstream's vertex stage
//    multiplies by 0.01, but only to UNDO a x100 it applied earlier ("to avoid
//    UV precision issues") - the net is a normalised UV, then main() halves it.
//    Reading that 0.01 as an extra shrink makes the UV a hundred times too
//    small, and then every noise and cosine argument is constant across the
//    picture: the whole frame collapses to one flat colour.
// 2. The two updates are SEQUENTIAL and in place: uv.x is written first, then
//    uv.y reads the already-updated uv.x. That feedback is essential - a
//    simultaneous update gives a visibly tamer field.
// 3. Amplitude is `swirl / i`, a harmonic series, so Iterations genuinely
//    increases warp STRENGTH (roughly as log n), not just detail. The 1.5 / 1.0
//    frequency asymmetry is what breaks the symmetry into marbling.

uniform float  shape;         // enum: 0 Checks, 1 Stripes, 2 Edge
uniform float  shapeScale;
uniform float  proportion;
uniform float  softness;
uniform float  distortion;
uniform float  swirl;
uniform float  swirlIterations;
uniform float  scale;
uniform float  rotation;
uniform float  colorCount;
uniform half4  color1;
uniform half4  color2;
uniform half4  color3;
uniform half4  color4;
uniform float  evolution;     // degrees
uniform float  loop;          // bool
uniform float  cycles;        // revolutions of Evolution before it repeats
uniform float2 resolution;

const float TWO_PI = 6.28318530718;

float wpHash21(float2 p) {
    p = fract(p * float2(0.3183099, 0.3678794)) + 0.1;
    p += dot(p, p + 19.19);
    return fract(p.x * p.y);
}
float wpVnoise(float2 p) {
    float2 i = floor(p), f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(wpHash21(i), wpHash21(i + float2(1.0, 0.0)), u.x),
               mix(wpHash21(i + float2(0.0, 1.0)), wpHash21(i + float2(1.0, 1.0)), u.x), u.y);
}
float2 wpRot(float2 p, float a) {
    float c = cos(a), s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}
half4 wpStop(int i) {
    if (i == 0) { return color1; }
    if (i == 1) { return color2; }
    if (i == 2) { return color3; }
    return color4;
}


// -------------------------------------------------------------- Evolution
//
// Everything that moves is driven by Evolution, in DEGREES - the same control
// After Effects' Turbulent Noise uses, and for the same reason: you keyframe
// it, so the rate is yours instead of being welded to the comp clock.
//
// Two kinds of term need different handling, and only the second is subtle:
//
//   - Terms inside sin/cos are periodic already, so they take the angle
//     straight and come home every 360 degrees.
//   - Noise SAMPLED at a moving offset never repeats, because the offset walks
//     away in a straight line forever. When looping it walks a CIRCLE instead,
//     sized so ONE LAP takes Cycles whole revolutions of Evolution.
//
// That is precisely what Cycles buys: a longer path through the noise before
// it arrives home, so more variation before the repeat. Cycles 2 means the
// field returns to its start at Evolution 720, not 360.
float evoAngle(float evolution) { return radians(evolution); }

float2 evoDrift(float evolution, float looping, float cycles, float radius) {
    float a = radians(evolution);
    if (looping > 0.5) {
        // Whole revolutions only - a fractional lap would land mid-circle at
        // the wrap and jump.
        float c = max(floor(cycles + 0.5), 1.0);
        return radius * c * float2(cos(a / c), sin(a / c));
    }
    return float2(a) * radius;      // free-running: walks away and never returns
}

half4 main(float2 coord) {
    float2 res = max(resolution, float2(1.0));

    // Upstream's pattern UV is PIXELS / 100 (the vertex stage's x0.01 cancels a
    // x100, it is not an extra shrink), then main() halves it. So on a 900px
    // layer the working coordinate spans about +-2.2, not +-0.25 - and that
    // span is what sets how much detail the swirl can develop. Normalising to
    // the layer instead made it roughly ten times too small, which is why the
    // field collapsed to two or three big lobes.
    //
    // Pixel-based means the pattern does NOT rescale with the layer, matching
    // upstream's "fit: none". Use Scale to size it.
    float2 uv = coord / 100.0;
    uv = wpRot(uv, radians(rotation));
    uv /= max(scale, 0.01);
    uv *= 0.5;

    float t = evoAngle(evolution);
    // The 118 is upstream's own first-frame offset - a seed so the field is not
    // degenerate at Evolution 0. It shifts WHERE the noise is sampled, never
    // how fast, so it cannot break the loop.
    float2 nOff = evoDrift(evolution, loop, cycles, 1.0) + 118.0;

    // Noise warp first - it seeds the swirl. Direction from one noise field,
    // magnitude from a second.
    float n1 = wpVnoise(uv * 1.0 + nOff);
    float n2 = wpVnoise(uv * 2.0 - nOff);
    float ang = n1 * TWO_PI;
    uv.x += 4.0 * distortion * n2 * cos(ang);
    uv.y += 4.0 * distortion * n2 * sin(ang);

    // Sequential, in-place, harmonic. The loop bound is a compile-time constant
    // and Iterations only breaks early, exactly as upstream does - note that
    // Iterations = 10 therefore runs i = 1..9.
    for (int i = 1; i <= 20; i++) {
        if (i >= int(swirlIterations)) { break; }
        float fi = float(i);
        uv.x += swirl / fi * cos(t + fi * 1.5 * uv.y);
        uv.y += swirl / fi * cos(t + fi * 1.0 * uv.x);
    }

    float prop = clamp(proportion, 0.0, 1.0);
    float propBias = 0.48 * sign(prop - 0.5) * pow(abs(prop - 0.5), 0.5);

    float sh;
    int sp = int(shape);
    if (sp == 0) {
        float2 c = uv * (0.5 + 3.5 * shapeScale);
        sh = 0.5 + 0.5 * sin(c.x) * cos(c.y) + propBias;
    } else if (sp == 1) {
        float f = fract(uv.y * (2.0 * shapeScale));
        sh = smoothstep(0.0, 0.55, f) * (1.0 - smoothstep(0.45, 1.0, f)) + propBias;
    } else {
        float ss = 5.0 * (1.0 - shapeScale);
        float e0 = 0.45 - ss, e1 = 0.55 + ss;
        sh = smoothstep(min(e0, e1), max(e0, e1), 1.0 - uv.y + 0.3 * (prop - 0.5));
    }

    // No fwidth in SkSL. At the default Softness of 1 the blend is a raw linear
    // ramp and this term drops out entirely; it only sets the antialiasing of
    // the hard-edged low-Softness case, where a fixed fraction of the frame is
    // a good enough stand-in for a field this irregular.
    float aa = 2.0 / 100.0;   // one pixel, in the same units as `uv` above

    int n = int(clamp(colorCount, 1.0, 4.0));
    // SkSL has no max(int, int) - only the float overloads. Every identifier
    // after this line failed to resolve because the statement itself did not
    // compile, which is why one bad call reported as eight errors.
    float denom = n > 1 ? float(n - 1) : 1.0;
    float mixer = sh * denom;

    half4 g0 = wpStop(0);
    float3 grad = float3(g0.rgb) * float(g0.a);
    float gA = float(g0.a);

    // Sequential accumulation, not a weighted average: each stop is mixed onto
    // the running gradient with its own clamped unit segment, so earlier stops
    // are fully overwritten below the current one.
    for (int i = 1; i < 4; i++) {
        if (i >= n) { break; }
        float m = clamp(mixer - float(i - 1), 0.0, 1.0);
        float soft = 0.5 * softness + aa;
        float smoothed = smoothstep(max(0.0, 0.5 - soft - aa), min(1.0, 0.5 + soft + aa), m);
        m = mix(smoothed, m, clamp(softness, 0.0, 1.0));

        half4 ci = wpStop(i);
        float3 cp = float3(ci.rgb) * float(ci.a);
        grad = mix(grad, cp, m);
        gA   = mix(gA, float(ci.a), m);
    }

    grad += 0.0039 * (wpHash21(coord * 0.021) - 0.5);
    return half4(half3(clamp(grad, 0.0, 1.0)), half(clamp(gA, 0.0, 1.0)));
}
