// Lens Blur, pass 5 of 6 - Field Kit
// The last segment blur, then out of the gamma domain, optional tone map, and
// composite over the untouched layer. Highlight extraction happened in
// lensPrepare.sksl - see that file for why it is not done here.

uniform float  bokehGamma;
uniform float  bokehThreshold;
uniform float  defocus;
uniform float  size;          // scatter radius - only used to match the padding
uniform float  blades;
uniform float  rotation;
uniform float  bokehSqueeze;  // 1 = spherical/round, else anamorphic ellipse
uniform float  bokehAngle;    // degrees, axis the squeeze acts along
uniform float  catsEye;       // optical vignetting: clips the aperture off-axis
uniform float  catsEyeFalloff;
uniform float  ringBias;      // weights taps toward the aperture edge
uniform float  cocSource;
uniform float  mapMode;       // enum: 0 map is a blur amount, 1 map is depth
uniform float  focus;
uniform float  aperture;
uniform float  focusShape;    // enum: 0 circle, 1 line
uniform float2 focusPoint;    // px offset from layer centre
uniform float  focusSize;     // px - radius, or half-width of the sharp band
uniform float  focusAspect;   // circle only: 1 round, else an ellipse
uniform float  focusSoftness; // px the blur takes to come on past that
uniform float  focusAngle;    // degrees, orientation of the Line band
uniform float  exposure;      // 0 = no tone map
uniform float  dither;
uniform float  occlusion;     // near/far separation strength
uniform float  edges;         // enum: 0 transparent, 1 clamp, 2 mirror
uniform float2 edgeTrim;      // px inset the clamp/mirror rect folds against

uniform float  segIndex;

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader defocusMap;    // shaderData - Focus From: Texture
uniform shader childShader;   // result of the previous segment blurs
uniform shader original;      // untouched input - MUST be declared last

const int MAX_SAMPLES = 24;

// Anamorphic aperture - see lensSegment.sksl for the rationale; the two files
// must build the same aperture or the segments disagree.
float2 anamorph(float2 v) {
    float sq = max(bokehSqueeze, 0.01);
    if (abs(sq - 1.0) < 1e-4) { return v; }
    float a = radians(bokehAngle);
    float2 ax = float2(cos(a), sin(a));
    float2 pe = float2(-ax.y, ax.x);
    return ax * (dot(v, ax) * sq) + pe * dot(v, pe);
}

// Edge handling for the gather - see lensSegment.sksl.
// Fold against the rect inset by the filter's own PADDING, not the raw
// resolution. paddingExpression grows the working area so a wide blur is not
// clipped, which means `resolution` describes the padded bounds - mostly empty
// - and folding against those did nothing at all. printPaper.sksl:47 hit the
// same trap. This recomputes the padding from the same two uniforms the
// expression uses, so the two can never drift apart.
float2 padInset() {
    return float2(ceil(max(defocus, 0.0) * 1.5 + max(size, 0.0) * 3.0));
}

float2 applyEdges(float2 c) {
    if (edges < 0.5) { return c; }
    float2 res = max(resolution, float2(1.0));
    float2 trim = clamp(max(edgeTrim, float2(0.0)) + padInset(), float2(0.0), res * 0.45);
    float2 inner = res - trim * 2.0;
    float2 lo = rectCentre - res * 0.5 + trim;
    float2 t = (c - lo) / inner;
    if (edges < 1.5) {
        t = clamp(t, 0.0, 1.0);
    } else {
        float2 m = mod(t, 2.0);
        t = 1.0 - abs(1.0 - m);
    }
    float2 half_px = 0.5 / inner;
    return lo + clamp(t, half_px, 1.0 - half_px) * inner;
}

float hash12(float2 p) {
    p = fract(p * float2(5.3987, 5.4421));
    p += dot(p.yx, p.xy + float2(21.5351, 14.3137));
    return fract(p.x * p.y * 95.4307);
}

float cocAt(float2 coord) {
    int m = int(cocSource);
    if (m == 0) { return 1.0; }

    // Focus Region: a place in the FRAME that stays sharp, rather than a value
    // in a matte. This is the right model whenever focus is not coming from
    // real depth - it replaced a Linear Ramp that could only ever be a
    // gradient across the whole frame with a fixed origin.
    //
    // Circle is a focus vignette: sharp inside the radius, blurring outward.
    // Line is a sharp BAND perpendicular to its angle, which is the tilt-shift
    // look, and reproduces the old ramp by pushing the point off-frame so only
    // one side of the band is visible.
    //
    // Returns the falloff directly rather than going through the focus/aperture
    // thin-lens curve below - there is no depth here to model, so Size and
    // Softness are the honest controls.
    if (m == 3) {
        float2 d = coord - rectCentre - focusPoint;
        float fa = radians(focusAngle);
        float cs = cos(fa), sn = sin(fa);
        // Rotate into the region's own frame, so Angle turns the ellipse as
        // well as the band.
        float2 dr = float2(d.x * cs + d.y * sn, -d.x * sn + d.y * cs);
        float dist;
        if (focusShape < 0.5) {
            // Aspect stretches the circle into an ellipse - a wide sharp zone
            // across a landscape, or a tall one down a portrait.
            dr.x /= max(focusAspect, 0.01);
            dist = length(dr);
        } else {
            dist = abs(dr.y);
        }
        float inner = max(focusSize, 0.0);
        return smoothstep(inner, inner + max(focusSoftness, 1.0), dist);
    }

    float2 res = max(resolution, float2(1.0));
    float z;
    // Read the layer ONLY for the two modes that need it. This used to be
    // fetched unconditionally, so Map mode paid for a texture read it never
    // looked at - once per tap, with Occlusion on.
    if (m == 1) {
        z = float(original.eval(coord).a);
    } else if (m == 2) {
        half4 c = original.eval(coord);
        float3 lin = c.a > 0.0 ? float3(c.rgb / c.a) : float3(0.0);
        z = dot(lin, float3(0.299, 0.587, 0.114));
    } else if (m == 4) {
        // A real map, rather than inferring the circle of confusion from the image.
        half4 dm = defocusMap.eval(coord);
        // Guarded divide, NOT a ternary. An unconnected shaderData input is
        // substituted as a constant half4(0), and SkSL constant-folds BOTH arms
        // of a ternary at compile time - so `a > 0 ? rgb / a : rgb` becomes 0/0
        // and the whole shader fails to compile with "division by zero". The
        // guard never runs. max() cannot fold to zero, so it is always safe.
        float3 lin = float3(dm.rgb) / max(float(dm.a), 1e-6);
        z = dot(lin, float3(0.299, 0.587, 0.114));
    } else {
        z = 0.0;
    }
    // One map, two readings - see lensSegment.sksl.
    if (m == 4 && mapMode < 0.5) { return clamp(z * aperture, 0.0, 4.0); }
    // Thin-lens circle of confusion. The old form divided by (z + 0.3), a fudge
    // standing in for the real relation - and it is a HYPERBOLA, not a line:
    // the circle of confusion goes as |1/z - 1/focus|, because a lens focuses
    // by reciprocal distance, not distance. That is why a subject a metre
    // closer than the focal plane blurs far harder than one a metre further,
    // and why the old curve looked wrong on real depth. Written as
    // |focus/z - 1| it is the same hyperbola normalised by the focal distance,
    // so Aperture keeps meaning what it did and no new controls are needed.
    if (m == 4) {
        float zf = max(z, 0.02);
        return clamp(abs(focus / zf - 1.0) * aperture, 0.0, 4.0);
    }
    // Alpha and Luminance are MATTES, not distances - there is no reciprocal
    // relation to appeal to, so they keep the plain falloff either side of the
    // focus value. Applying the lens hyperbola here would have made every dark
    // pixel blur enormously for no reason a lens would recognise.
    return clamp(abs(z - focus) / (z + 0.3) * aperture, 0.0, 4.0);
}

// See lensSegment.sksl for the reasoning - identical shaping, kept in sync so
// this last segment matches the ones before it.
float apertureWeight(float2 fragCoord, float2 dir, float t) {
    float apertureRadius = abs(t) * 2.0;
    // Round aperture - chord-length weighting; see lensSegment.sksl.
    float ringW = blades < 1.0
        ? pow(max(1.0 - apertureRadius * apertureRadius, 0.0), 0.2)
        : 1.0;
    // Ring Bias, both ways. A lens under-corrected for spherical aberration
    // brightens the RIM of the disc - ring, or soap-bubble, bokeh. An
    // over-corrected one brightens the CENTRE and gives the soft, creamy
    // rendering portrait lenses are prized for. (Nasse, "Depth of Field and
    // Bokeh", Zeiss 2010.) It used to only go one way, so half of what real
    // glass does was unreachable.
    float rb = clamp(ringBias, -1.0, 1.0);
    // Floored at 0.4 rather than reaching zero. A separable sum of 1D
    // segments cannot express a true bright rim, and driving the centre taps
    // to zero hollows out each 1D blur - which reads as a cross or star, not
    // as ring bokeh. Keeping every tap contributing makes this a bias on the
    // disc rather than a broken kernel.
    float edgeW   = mix(0.4, 1.0, smoothstep(0.35, 1.0, apertureRadius));
    float centreW = mix(0.4, 1.0, 1.0 - smoothstep(0.0, 0.75, apertureRadius));
    ringW = rb >= 0.0 ? mix(ringW, edgeW, rb) : mix(ringW, centreW, -rb);

    if (catsEye <= 0.0) { return ringW; }

    float2 res = max(resolution, float2(1.0));
    float2 fromCentre = (fragCoord - rectCentre) / (0.5 * min(res.x, res.y));
    float  r = clamp(length(fromCentre), 0.0, 1.0);
    float2 clipDir = r > 1e-4 ? fromCentre / r : float2(0.0);
    float  shift = catsEye * pow(r, max(catsEyeFalloff, 0.1));

    float2 o = dir * (t * 2.0);   // tap offset in aperture space, -1..1
    float  aa = 2.0 / float(MAX_SAMPLES);   // soften by about one sample step

    // The barrel's clip is a circle the same size as the aperture, slid
    // radially. Its radius carries the +aa or the softened rim shaves the blob
    // even on-axis where nothing should clip, and the slide is capped below
    // 1.0 because at a full aperture radius the circles barely overlap and the
    // highlight vanishes instead of turning into a lemon.
    float  clipR = 1.0 + aa;
    float  clipped = 1.0 - smoothstep(clipR - aa, clipR + aa,
                                      length(o - clipDir * (shift * 0.7)));

    return ringW * clipped;
}

// Near/far separation. A plain gather gives every tap an equal say, so a
// blurred BACKGROUND smears over a sharp foreground - the most visible error
// in screen-space depth of field, and the one Barsky & Kosloff's survey names
// as the limit of gather-based methods.
//
// The fix is to ask whether a tap could physically have reached this pixel: a
// point only spreads as far as its OWN circle of confusion. A sharp foreground
// pixel has a tiny one, so it cannot contribute to a distant pixel and stops
// bleeding outward; a blurred background pixel has a large one and still
// spreads normally. Scatter-as-gather, in the Garcia (2017) sense.
//
// Costs one extra matte read per tap, so it is a control rather than always on.
float occlusionWeight(float2 tapCoord, float2 off) {
    if (occlusion <= 0.0) { return 1.0; }
    float dist   = length(off);
    if (dist < 1e-4) { return 1.0; }
    float tapCoc = max(defocus, 0.0) * cocAt(tapCoord);
    float ok = smoothstep(-1.0, 0.0, (tapCoc - dist) / max(dist, 1.0));
    return mix(1.0, ok, clamp(occlusion, 0.0, 1.0));
}

half4 main(float2 fragCoord) {
    // Round spends every segment on the circle.
    float segCount = blades < 1.0 ? 4.0 : max(floor(blades * 0.5 + 0.5), 1.0);
    float g = max(bokehGamma, 0.0001);

    float3 acc;
    float  accA;

    if (segIndex >= segCount) {
        // This segment is unused at the current blade count.
        half4 c = childShader.eval(fragCoord);
        acc  = c.a > 0.0 ? float3(c.rgb / c.a) : float3(c.rgb);
        accA = float(c.a);
    } else {
        float r = max(defocus, 0.0) * cocAt(fragCoord);
        float ang = radians(rotation) + 3.14159265 * segIndex / segCount;
        float2 dir = float2(cos(ang), sin(ang));
        float n = float(MAX_SAMPLES);
        float jit = dither > 0.5 ? hash12(fragCoord + segIndex * 17.3) : 0.5;

        float3 sum  = float3(0.0);
        float  sumA = 0.0;
        float  cnt  = 0.0;
        for (int i = 0; i < MAX_SAMPLES; i++) {
            float t = (float(i) + jit) / n - 0.5;
            float w = apertureWeight(fragCoord, dir, t);
            float2 off = anamorph(dir * (t * r));
            w *= occlusionWeight(fragCoord + off, off);
            half4 c = childShader.eval(applyEdges(fragCoord + off));
            sum  += w * (c.a > 0.0 ? float3(c.rgb / c.a) : float3(c.rgb));
            sumA += w * float(c.a);
            cnt  += w;
        }
        acc  = sum / max(cnt, 0.0001);
        accA = sumA / max(cnt, 0.0001);
    }

    // Undo the global lift lensPrepare applied - nothing else. Gain now acts on
    // highlights before the blur, where it belongs; multiplying here scaled the
    // whole picture instead.
    float3 col = pow(max(acc, 0.0), float3(1.0 / g));
    // Tone map only what is defocused AND bright - the discs, in other words.
    // Gating on defocus alone was not enough: at a large radius almost the whole
    // frame is defocused, so it still re-graded the entire picture. Exposure
    // exists to roll off bokeh that Highlight Gain has driven near clipping, so
    // it belongs on the same highlights Gain acted on, not on the blur at large.
    if (exposure > 0.0) {
        float blurred = clamp(cocAt(fragCoord), 0.0, 1.0);
        float thr = clamp(bokehThreshold, 0.0, 0.999);
        float lum = dot(col, float3(0.2126, 0.7152, 0.0722));
        float hi  = smoothstep(thr, min(thr + 0.15, 1.0), lum);
        col = mix(col, float3(1.0) - exp(-col * exposure), blurred * hi);
    }
    col = clamp(col, 0.0, 1.0);

    // A lens defocus REPLACES the picture rather than adding a bloom over it -
    // the highlight threshold only shapes which highlights form discs. The
    // final composite belongs to pass 8, so the chain continues from here.
    half a = half(clamp(accA, 0.0, 1.0));
    return half4(half3(clamp(col, 0.0, 1.0)) * a, a);
}
