// Print, pass 5 of 6 - Field Kit
// Paper tooth: a fibre texture that catches slightly more ink in its
// crevices, so it reads mostly where the print has already laid colour down
// rather than as a wash over the whole frame. Then the final Amount mix
// against the untouched layer.

uniform float trueColour;
uniform float paperTooth;
uniform float  paperFolds;
uniform float  paperFoldCount;
uniform float  paperCrumples;
uniform float  paperCrumpleSize;
uniform float  paperFibre;
uniform float  paperRelief_;
uniform float seed;
uniform float boil;
uniform float time;
uniform float amount;

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader childShader;  // all plates printed

// STOP-MOTION BOIL. Every random thing in the press - grain, ink loss, mottle,
// edge breakup, which way each plate drifts - is keyed off the seed. Advancing
// it in HOLDS rather than continuously is what makes it read as re-printed by
// hand each time rather than as animated noise: completely different on each
// new impression, perfectly still in between.
//
// Boil is the hold length in frames, so 2 gives the classic on-twos chatter.
// Zero holds a single impression forever.
float boiledSeed(float baseSeed, float t, float hold) {
    if (hold < 0.5) { return baseSeed; }
    return baseSeed + floor(t / hold) * 17.13;
}
uniform shader original;     // untouched input - MUST be declared last

float hash2(float2 p) {
    p = fract(p * float2(123.34, 456.21) + boiledSeed(seed, time, boil) * 0.123);
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float fibre(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    float a = hash2(i);
    float b = hash2(i + float2(1.0, 0.0));
    float c = hash2(i + float2(0.0, 1.0));
    float d = hash2(i + float2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}


// ---------------------------------------------------------- Paper relief
// Shared with `paperTexture.sksl` (the Shader layer), which is the canonical
// copy, and with photocopy.sksl / printComposite.sksl. There is no include
// mechanism here, so keep the four in sync by hand if this is edited.
//
// Derived from paper-design/shaders `paper-texture.ts` (Apache-2.0, Lost Coast
// Labs). Changes: SkSL port, procedural hashes in place of their noise
// texture, three layers rather than five.
//
// Each layer is skipped when its own uniform is zero. The branches are
// uniform-driven, so every fragment takes the same path - which is what keeps
// this affordable at default settings, where most of it is switched off.
float2 pbHash22(float2 p) {
    p = fract(p * float2(0.3183099, 0.3678794)) + 0.1;
    p += dot(p, p + 19.19);
    float a = fract(p.x * p.y);
    float b = fract((p.x + 71.3) * (p.y + 13.7));
    return float2(a, b);
}
float pbHash21(float2 p) { return pbHash22(p).x; }
float pbVnoise(float2 p) {
    float2 i = floor(p), f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(pbHash21(i), pbHash21(i + float2(1.0, 0.0)), u.x),
               mix(pbHash21(i + float2(0.0, 1.0)), pbHash21(i + float2(1.0, 1.0)), u.x), u.y);
}
float2 pbRot(float2 p, float a) {
    float c = cos(a), s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}
// A weighted average of jittered cell values, not a Voronoi distance. Two
// frequencies multiplied - one sharp, one soft - is what gives crumpled foil.
float pbCrumpled(float2 t, float pw) {
    float2 p = floor(t);
    float wsum = 0.0, cl = 0.0;
    for (int y = -1; y < 2; y++) {
        for (int x = -1; x < 2; x++) {
            float2 q = p + float2(float(x), float(y));
            float2 r = (q + pbHash22(q)) - t;
            float w = pow(smoothstep(0.0, 1.0, 1.0 - abs(r.x)), pw)
                    * pow(smoothstep(0.0, 1.0, 1.0 - abs(r.y)), pw);
            cl += (0.5 + 0.5 * sin((q.x + q.y * 5.0) * 8.0)) * w;
            wsum += w;
        }
    }
    return pow(wsum > 0.0 ? cl / wsum : 0.0, 0.5) * 2.0;
}
float pbCrumpleShape(float2 uv) {
    return pbCrumpled(uv * 0.25, 16.0) * pbCrumpled(uv * 0.5, 2.0);
}
// Returns the VECTOR to the nearest crease boiledSeed(seed, time, boil), not a distance - so a crease
// perturbs the surface outward from its own origin, which is what makes it
// read as a fold rather than as a contour line.
float2 pbFolds(float2 uv, float count, float sd) {
    float2 best = float2(0.0);
    float bestD = 9.0;
    for (int i = 0; i < 15; i++) {
        if (float(i) >= count) { break; }
        float2 rnd = pbHash22(float2(float(i), float(i) * sd + 3.1));
        float an = rnd.x * 6.28318530718;
        float2 pp = float2(cos(an), sin(an)) * rnd.y;
        float d = distance(uv, pp);
        if (d < bestD) { bestD = d; best = uv - pp; }
    }
    return mix(best, float2(0.0), pow(clamp(bestD, 0.0, 1.0), 0.25));
}
// Returns 1 where the sheet faces the light, below 1 where it turns away.
// `relief` steepens the normal's own Z rather than remapping the result, which
// keeps the shading physical at both ends.
float paperRelief(float2 fragCoord, float2 res, float2 rc,
                  float foldAmt, float foldN, float crumpleAmt, float crumpleSz,
                  float fibreAmt, float relief, float sd) {
    if (foldAmt <= 0.0 && crumpleAmt <= 0.0 && fibreAmt <= 0.0) { return 1.0; }
    float2 uv = (fragCoord - rc) / max(res.y, 1.0);
    float2 patternUV = uv * 10.0;
    float2 normal = float2(0.0);
    if (foldAmt > 0.0) {
        float2 fUV = pbRot(patternUV * 0.12, 4.0 * sd);
        float2 w  = pbFolds(fUV, foldN, sd);
        float2 w2 = pbFolds(pbRot(fUV + 0.007 * cos(sd), 0.01 * sin(sd)), foldN, sd);
        normal += foldAmt * 4.0 * max(float2(0.0), w + w2);
    }
    if (crumpleAmt > 0.0) {
        float2 cUV = fract(patternUV * 0.02 / max(crumpleSz, 0.01) - sd) * 32.0;
        normal += crumpleAmt * (pbCrumpleShape(cUV + float2(0.05, 0.0)) - pbCrumpleShape(cUV));
    }
    if (fibreAmt > 0.0) {
        float2 g = patternUV * 6.0;
        normal += 0.4 * fibreAmt * float2(pbVnoise(g + float2(0.7, 0.0)) - pbVnoise(g - float2(0.7, 0.0)),
                                          pbVnoise(g + float2(0.0, 0.7)) - pbVnoise(g - float2(0.0, 0.7)));
    }
    float z = 9.5 - 9.0 * pow(clamp(relief, 0.0, 1.0), 0.1);
    float lam = dot(normalize(float3(normal, z)), normalize(float3(1.0, 2.0, 1.0)));
    return clamp(0.35 + 0.9 * lam, 0.0, 1.6);
}

half4 main(float2 fragCoord) {
    half4 src = childShader.eval(fragCoord);

    if (paperTooth > 0.0) {
        float3 lin = src.a > 0.0 ? float3(src.rgb / src.a) : float3(1.0);
        float g = fibre(fragCoord * 0.3) * 0.5 + fibre(fragCoord * 0.5) * 0.5;   // ~3px and ~2px cells
        float lum = dot(lin, float3(0.299, 0.587, 0.114));
        float inked = 1.0 - lum;
        float shade = 1.0 - paperTooth * 0.25 * g * inked;
        lin *= shade;
        src = half4(half3(clamp(lin, 0.0, 1.0)) * src.a, src.a);
    }

    // A CREASE TAKES LESS INK. Physically this belongs at screening time, in
    // the plate passes - but printPlate is already the largest shader in the
    // kit and its uniform list is duplicated four times, so putting it there
    // costs a lot for a refinement. Lifting the ink here, where the composited
    // result is in hand, lands in almost the same place: the fold reads as
    // raised and takes less pigment, and the sheet under it is already lit.
    float relief = paperRelief(fragCoord, resolution, rectCentre, paperFolds, paperFoldCount,
                            paperCrumples, paperCrumpleSize, paperFibre, paperRelief_, boiledSeed(seed, time, boil));
    if (relief < 0.999 || relief > 1.001) {
        float3 lin2 = float3(src.rgb) / max(float(src.a), 1e-6);
        float inked2 = clamp(1.0 - dot(lin2, float3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
        lin2 = mix(lin2, float3(1.0), clamp((1.0 - relief) * inked2, 0.0, 1.0));
        src = half4(half3(clamp(lin2, 0.0, 1.0)) * src.a, src.a);
    }

    half4 orig = original.eval(fragCoord);

    // COLOUR FIDELITY - a GAIN on the print, not a blend with the source.
    //
    // Blending the final pixels was wrong, and wrong in a way that showed: at 1
    // the result IS the source, so the press is thrown away entirely and the
    // artwork is simply pasted on top. Everything that makes it a print - the
    // multiply where two inks overlap, the misregistration band, the grain -
    // fades out in proportion to the correction.
    //
    // The print is multiplicative: paper times the transmittance of each ink.
    // So correct it multiplicatively. Take the print's REGIONAL colour and the
    // artwork's regional colour - the same blur on both - and apply their ratio
    // as a gain. Regional colour lands on the artwork's; every local deviation
    // from it survives untouched, because a ratio preserves ratios. An overlap
    // twice as dark as its surroundings stays twice as dark.
    //
    // Blurring BOTH with the same radius is also what kills the halo the early
    // versions had: they compared a smoothed quantity against a sharp one,
    // which is an unsharp mask. Smooth both and edges agree.
    float tc = clamp(trueColour, 0.0, 1.0);
    if (tc > 0.0 && orig.a > 0.0) {
        // WIDE, and that is the point. The print is offset from the source by
        // the registration drift, so a narrow blur has the two disagreeing
        // about which shape a pixel belongs to right at every boundary - the
        // ratio spikes and you get ghost outlines. A wide kernel averages both
        // sides of any edge in both images, so they agree again and the gain
        // varies slowly. Regional colour is a low-frequency quantity anyway;
        // measuring it locally was the error.
        const float R = 14.0;
        float3 pSum = float3(0.0), sSum = float3(0.0);
        float  pDen = 0.0, sDen = 0.0;
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                float2 o = float2(float(x), float(y)) * R;
                half4 pc = childShader.eval(fragCoord + o);
                half4 sc = original.eval(fragCoord + o);
                if (pc.a > 0.001) { pSum += float3(pc.rgb) / float(pc.a); pDen += 1.0; }
                if (sc.a > 0.001) { sSum += float3(sc.rgb) / float(sc.a); sDen += 1.0; }
            }
        }
        float3 printed = src.a > 0.0 ? float3(src.rgb / src.a) : float3(1.0);
        if (pDen > 0.5 && sDen > 0.5) {
            float3 pFlat = pSum / pDen;
            float3 sFlat = sSum / sDen;
            // Bounded: where the print is near black the ratio would explode.
            float3 gain = clamp(sFlat / max(pFlat, float3(0.02)), float3(0.25), float3(4.0));
            float3 corrected = clamp(printed * mix(float3(1.0), gain, tc), 0.0, 1.0);
            src = half4(half3(corrected) * src.a, src.a);
        }
    }

    return mix(orig, src, half(clamp(amount, 0.0, 1.0)));
}
