// GENERATED by src/build.cjs from glowStreak.sksl - do not edit.
// Pass constants baked in so this runs on Cavalry 2.7.2, whose pass
// spec has no `constants` support. Edit the source file instead.
// Glow, passes 2-4 of 13 - Field Kit
// The directional smear, as a chained blur with a doubling step.
//
// WHY THE STREAK COMES FIRST. Bloom and streak both want to accumulate from the
// same highlights, but a multipass chain carries only ONE image forward - there
// is nowhere to keep two independent accumulations. So the streak is built
// first and the bloom ladder then runs over it, which couples them: you get the
// streak, plus bloom around the streak, plus bloom of the highlights. That is
// closer to a real flare than two independent glows summed, because a real
// streak does bloom.
//
// `stepScale` comes from the pass constants; the span doubles each pass, so
// three passes of `samples` taps reach as far as a single gather would need
// hundreds for, without the discrete ghost copies a sparse gather produces.
//
// One axis per filter. Chaining is what buys the quality and it cannot hold
// several spike directions at once - blurring an already-starred image again
// spreads it into a blob. Stack two Glows at different angles for a cross.

uniform float  srcBlack;      // the streak re-derives highlights, so it
uniform float  srcWhite;      // needs the same three grade controls pass 0 used
uniform float  response;
uniform float  streakAmount;
uniform float  streakIntensity; // multiplier on the streak, over the global Intensity
uniform float  reach;
uniform float  angle;
uniform float  samples;
uniform float  streakFalloff;
uniform float  bidirectional;

const float stepScale = 0.250000;   // baked from the pass constant

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader childShader;   // the bloom so far - the streak ADDS onto this
uniform shader original;      // untouched input - MUST be declared last

// Re-derived rather than read from childShader. The streak now runs AFTER the
// bloom, so childShader holds a wide soft veil; smearing that would just smear
// the veil. The streak has to come from the sharp highlights, which means
// grading them here exactly as pass 0 did.
float3 streakHighlights(float2 coord) {
    half4 c = original.eval(coord);
    float3 lin = c.a > 0.0 ? float3(c.rgb / c.a) : float3(0.0);
    float bp = srcBlack;
    float wp = max(srcWhite, bp + 0.0001);
    return pow(clamp((lin - bp) / (wp - bp), 0.0, 1e4),
               float3(max(response, 0.0001)));
}

const int MAX_TAPS = 32;

// Sub-tap jitter, as in glowBloom.sksl: `samples` taps spread over `reach`
// sit tens of pixels apart at the wide end, so a sharp highlight lands as that
// many discrete copies. Shifting the kernel by a fraction of a tap per pixel
// breaks them into noise the later passes smooth out. Position-keyed, so it
// does not crawl between frames.
float hash21(float2 p) {
    p = fract(p * float2(127.1, 311.7));
    p += dot(p, p + 34.23);
    return fract(p.x * p.y);
}

half4 main(float2 fragCoord) {
    if (streakAmount <= 0.0) { return childShader.eval(fragCoord); }

    // CHAINED, and running after the bloom.
    //
    // A point of light needs CONTINUOUS coverage along the streak. Gathering N
    // taps over L pixels leaves a dotted line unless the spacing is about a
    // pixel - at reach 300 that would want 300 taps. Chaining solves it for
    // free: the first pass turns each point into a short dotted streak, and
    // every pass after smears what it finds, so the gaps close progressively
    // and 16 taps are enough.
    //
    // The cost is that the later passes smear the BLOOM they are sitting on top
    // of as well, elongating the veil along the streak axis. That is scaled by
    // Streak Amount, so it only happens once a streak has been asked for - and
    // a real anamorphic flare stretches its whole glow the same way.
    // DOUBLING STRIDE, not a dense gather.
    //
    // A long directional blur does not need taps every pixel if each pass
    // strides further than the last. Pass 1 lays down `n` contiguous samples at
    // spacing d, so every point becomes a solid block d*n long. Pass 2 strides
    // n*d - landing on the blocks pass 1 already filled, so nothing is missed -
    // and pass 3 strides n*n*d. Reach grows as n^3 while cost grows as 3n.
    //
    // At n = 6 that is 18 taps for a 216d streak, where gathering the same
    // length densely would want 216. The previous version spent 36 taps to
    // cover it and still left gaps, which is what the speckle was.
    bool first = stepScale <= 0.25;
    float n = clamp(floor(samples), 2.0, float(MAX_TAPS));
    float rank = first ? 0.0 : (stepScale <= 0.5 ? 1.0 : 2.0);

    // SPAN RATIOS ARE FIXED; samples only sets density within them.
    //
    // Deriving the stride from n^3 made Samples a length control by accident:
    // raising it shrank the base stride cubically while adding only n taps, so
    // the taps bunched toward the origin and - since each pass normalises by
    // its own weights - the far end was diluted away. More samples gave a
    // SHORTER streak, which is the opposite of what the control says.
    //
    // The three passes now always cover 1:4:16 of the total, summing to Length
    // whatever n is. Continuity still holds as long as pass k+1's stride is no
    // longer than the block pass k filled, which needs n >= 4 - hence the
    // minimum on Samples.
    float spanFrac = pow(4.0, rank) / 21.0;
    float span = max(reach, 0.0) * spanFrac;
    float stride = span / max(n, 1.0);

    float ang  = radians(angle);
    float2 dir = float2(cos(ang), sin(ang));
    bool both  = bidirectional > 0.5;

    float3 sum  = float3(0.0);
    float  wsum = 0.0;

    float jitter = hash21(fragCoord + dir * 31.0) - 0.5;

    for (int i = 0; i < MAX_TAPS; i++) {
        if (float(i) >= n) { continue; }
        float k = float(i) + jitter;
        float dist = k * stride;

        // Envelope over the WHOLE streak, so the three passes together carry
        // one continuous 1/u^2 falloff rather than each restarting it.
        float ud = dist / max(reach, 1.0) * max(streakFalloff, 0.0) * 3.0;
        float w = 1.0 / (1.0 + ud * ud);

        sum  += (first ? streakHighlights(fragCoord + dir * dist)
                       : float3(childShader.eval(fragCoord + dir * dist).rgb)) * w;
        wsum += w;
        if (both) {
            sum  += (first ? streakHighlights(fragCoord - dir * dist)
                           : float3(childShader.eval(fragCoord - dir * dist).rgb)) * w;
            wsum += w;
        }
    }

    float3 streak = sum / max(wsum, 0.0001);
    float3 here = float3(childShader.eval(fragCoord).rgb);
    float amt = clamp(streakAmount, 0.0, 1.0);

    // The first pass ADDS a fresh streak onto the bloom; the rest smear what is
    // already there, so they blend rather than add or the streak compounds.
    float3 outRgb = first ? here + streak * amt * max(streakIntensity, 0.0)
                          : mix(here, streak, amt);

    return half4(half3(clamp(outRgb, 0.0, 64.0)), half(1.0));
}
