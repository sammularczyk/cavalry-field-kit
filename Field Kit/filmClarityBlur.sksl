// Colour Recipe, passes 1 and 2 of 3 - Field Kit
// Separable gaussian of luminance, into the red channel: the reference for
// Clarity, which is local contrast against a blurred copy.
//
// `dirX`/`dirY`/`firstPass` come from the pass constants, so one file does both.
// Pass 0 must NOT declare `original` - it has no such input and the pass would
// fail to build silently. See the Ultra Glow / Lightwrap headers.

uniform float  clarityRadius;

uniform float  dirX;
uniform float  dirY;
uniform float  firstPass;

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader childShader;

const int TAPS = 16;

float2 srcAt(float2 coord) {
    half4 c = childShader.eval(coord);
    if (firstPass > 0.5) {
        float3 lin = c.a > 0.0 ? float3(c.rgb / c.a) : float3(0.0);
        return float2(dot(lin, float3(0.2126, 0.7152, 0.0722)), c.a > 0.0 ? 1.0 : 0.0);
    }
    return float2(float(c.r), c.a > 0.0 ? 1.0 : 0.0);
}

half4 main(float2 fragCoord) {
    float radius = max(clarityRadius, 0.0);
    if (radius < 0.5) {
        return half4(half3(half(srcAt(fragCoord).x)), half(1.0));
    }
    float2 dir = float2(dirX, dirY);
    float sum = 0.0;
    float den = 0.0;
    for (int i = -TAPS; i <= TAPS; i++) {
        float f = float(i) / float(TAPS);
        float w = exp(-f * f * 2.5);
        // Weight by coverage: a tap outside the layer is absent, not black.
        // Counting it dragged every edge pixel's blur toward zero, which shows
        // as a dark band a blur-radius deep along the border.
        float2 t = srcAt(fragCoord + dir * (f * radius));
        sum += t.x * w * t.y;
        den += w * t.y;
    }
    return half4(half3(half(sum / max(den, 0.0001))), half(1.0));
}
