// Mesh Gradient - Field Kit  (thirdPartyShader: a generator)
//
// Ported from paper-design/shaders `static-mesh-gradient.ts` (Apache-2.0, Lost
// Coast Labs). Changes: SkSL port; the colour array is unrolled to four stops
// (SkSL forbids dynamic array indexing); Position doubles as an animation
// phase so the same Layer covers the animated case, which upstream ships as a
// separate shader.
//
// SPOTS, NOT A GRID. Each colour is one spot placed on a Lissajous path, and
// every pixel is an inverse-distance weighted average of ALL of them - so there
// is no boundary anywhere in the field to see. Position is a SEED that slides
// every spot along its path; it is not a count. The number of spots is simply
// the number of colours.
//
// Mixing does two things at once, which is why one slider covers hard stripes
// through to a soft haze: it sets the distance EXPONENT (2 falls off fast, 1
// slowly) and the weight SHARPNESS (up to 8, which makes the nearest spot win
// outright). Pull both down and the spots blend; push both up and they tile.

uniform float  colorCount;
uniform half4  color1;
uniform half4  color2;
uniform half4  color3;
uniform half4  color4;
uniform float  positions;      // spot placement seed, 0..100
uniform float  waveX;
uniform float  waveXShift;
uniform float  waveY;
uniform float  waveYShift;
uniform float  swirl;
uniform float  mixing;
uniform float  grainMixer;
uniform float  grainOverlay;
uniform float  rotation;
uniform float  evolution;     // degrees
uniform float  loop;          // bool
uniform float  cycles;        // revolutions of Evolution before it repeats
uniform float2 resolution;

const float TWO_PI = 6.28318530718;

float mgHash21(float2 p) {
    p = fract(p * float2(0.3183099, 0.3678794)) + 0.1;
    p += dot(p, p + 19.19);
    return fract(p.x * p.y);
}
float2 mgRot(float2 p, float a) {
    float c = cos(a), s = sin(a);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}
half4 mgStop(int i) {
    if (i == 0) { return color1; }
    if (i == 1) { return color2; }
    if (i == 2) { return color3; }
    return color4;
}
// Each spot rides its own Lissajous path. The three constants are derived from
// the index so no two spots share a rate, and the field never repeats.
float2 mgSpot(int i, float t, float looping) {
    float fi = float(i);
    float a = fi * 0.37;
    float b = 0.6 + mod(fi, 3.0) * 0.3;
    float c = 0.8 + mod(fi + 1.0, 4.0) * 0.25;
    // The free-running rates are deliberately incommensurate so the field never
    // repeats. That is exactly what a loop cannot have, so when looping they
    // snap to whole numbers - every spot then completes an integer number of
    // orbits per cycle and they all arrive home together.
    if (looping > 0.5) {
        b = 1.0 + mod(fi, 3.0);
        c = 1.0 + mod(fi + 1.0, 4.0);
    }
    return 0.5 + 0.5 * float2(sin(t * b + a), cos(t * c + a * 1.5));
}


// -------------------------------------------------------------- Evolution
//
// Everything that moves is driven by Evolution, in DEGREES - the same control
// After Effects' Turbulent Noise uses, and for the same reason: you keyframe
// it, so the rate is yours instead of being welded to the comp clock.
//
// Two kinds of term need different handling, and only the second is subtle:
//
//   - Terms inside sin/cos are periodic already, so they take the angle
//     straight and come home every 360 degrees.
//   - Noise SAMPLED at a moving offset never repeats, because the offset walks
//     away in a straight line forever. When looping it walks a CIRCLE instead,
//     sized so ONE LAP takes Cycles whole revolutions of Evolution.
//
// That is precisely what Cycles buys: a longer path through the noise before
// it arrives home, so more variation before the repeat. Cycles 2 means the
// field returns to its start at Evolution 720, not 360.
float evoAngle(float evolution) { return radians(evolution); }

float2 evoDrift(float evolution, float looping, float cycles, float radius) {
    float a = radians(evolution);
    if (looping > 0.5) {
        // Whole revolutions only - a fractional lap would land mid-circle at
        // the wrap and jump.
        float c = max(floor(cycles + 0.5), 1.0);
        return radius * c * float2(cos(a / c), sin(a / c));
    }
    return float2(a) * radius;      // free-running: walks away and never returns
}

half4 main(float2 coord) {
    float2 res = max(resolution, float2(1.0));
    float2 uv = mgRot(coord / res, radians(rotation)) + 0.5;   // 0..1 over the layer

    // One time base drives everything that moves: the spots along their paths,
    // the phase of both waves, and the swirl. Earlier this only advanced the
    // spot seed, so at any Speed the warp itself sat perfectly still and the
    // colours slid underneath a frozen distortion - which reads as wrong even
    // when you cannot say why.
    float t = evoAngle(evolution);
    float wavePhase = t;
    float swirlPhase = t;
    float seed = 25.0 + 0.33 * positions + t;

    // Two fixed wave passes, damped toward the edges by `centre` so the warp
    // is strongest through the middle and the field stays calm at the border.
    float centre = 1.0 - smoothstep(0.0, 1.0, length(uv - 0.5));
    for (int i = 1; i <= 2; i++) {
        float fi = float(i);
        uv.x += waveX * centre / fi * cos(TWO_PI * waveXShift + wavePhase + fi * 2.0 * smoothstep(0.0, 1.0, uv.y));
        uv.y += waveY * centre / fi * cos(TWO_PI * waveYShift + wavePhase + fi * 2.0 * smoothstep(0.0, 1.0, uv.x));
    }

    // Swirl about the centre, strongest there and falling off with distance,
    // breathing slowly so it never settles into a fixed twist.
    if (swirl > 0.0) {
        float a = swirl * centre * (1.0 + 0.3 * sin(swirlPhase));
        uv = 0.5 + mgRot(uv - 0.5, a);
    }

    float mixAmt = pow(clamp(mixing, 0.0, 1.0), 0.7);
    float power  = mix(2.0, 1.0, mixAmt);

    int n = int(clamp(colorCount, 1.0, 4.0));
    float3 acc = float3(0.0);
    float  accA = 0.0;
    float  total = 0.0;

    for (int i = 0; i < 4; i++) {
        if (i >= n) { break; }
        float d = distance(uv, mgSpot(i, seed, loop));
        // Grain eats into the spot's reach, so the boundaries between colours
        // break up rather than staying clean.
        d += grainMixer * 0.1 * (mgHash21(coord * 0.37 + float2(float(i), 0.0)) - 0.5);
        float w = 1.0 / (pow(max(d, 0.0), power) + 1e-3);
        float sharp = mix(mix(0.0, 8.0, clamp(w, 0.0, 1.0)), 1.0, mixAmt);
        w = pow(w, sharp);
        half4 c = mgStop(i);
        acc  += float3(c.rgb) * w;
        accA += float(c.a) * w;
        total += w;
    }

    float3 col = acc / max(total, 1e-4);
    float  a   = clamp(accA / max(total, 1e-4), 0.0, 1.0);

    // Post grain, plus half a level of dither - a smooth gradient over a large
    // canvas bands badly in eight bits, and noise is cheaper than precision.
    col += grainOverlay * 0.25 * (mgHash21(coord * 1.7) - 0.5);
    col += 0.0039 * (mgHash21(coord * 0.017) - 0.5);

    return half4(half3(clamp(col, 0.0, 1.0)) * half(a), half(a));
}
