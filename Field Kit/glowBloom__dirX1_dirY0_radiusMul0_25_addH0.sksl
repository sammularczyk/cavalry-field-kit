// GENERATED by src/build.cjs from glowBloom.sksl - do not edit.
// Pass constants baked in so this runs on Cavalry 2.7.2, whose pass
// spec has no `constants` support. Edit the source file instead.
// Glow, passes 5-12 of 13 - Field Kit
// The isotropic bloom ladder, as four pairs of separable blurs.
//
// Inspired by "apGlow" v1.2 by Adrian Pueyo. apGlow sums N independent blurs at
// exponentially increasing radii; a sparse single-pass gather cannot do that
// honestly, because the tap count is fixed while the radius is not, so a large
// glow reads as a ring of ghost copies and jittering only trades those for
// shimmer.
//
// Blur is linear, so the whole ladder collapses into a chain. With H the graded
// highlights and S the running total:
//
//     S(k) = blur(S(k-1)) + H
//
// expands to H + blur(H) + blur^2(H) + ... - exactly a sum of progressively
// wider blurs, built from real separable 1D passes. H is recomputed here from
// `original` rather than carried, because the buffer is busy holding S.
//
// S(0) is the STREAK, not the raw highlights - see glowStreak.sksl. So the
// ladder blooms the streak as well as the highlights, which is the point.
//
// `dirX`/`dirY`/`radiusMul`/`addH` come from the pass constants.

uniform float  srcBlack;
uniform float  srcWhite;
uniform float  response;
uniform float  bloomAmount;
uniform float  steps;         // how many rungs of the ladder to actually run
uniform float  size;
uniform float  falloff;

const float dirX = 1.000000;   // baked from the pass constant
const float dirY = 0.000000;   // baked from the pass constant
const float radiusMul = 0.250000;   // baked from the pass constant
const float addH = 0.000000;   // baked from the pass constant

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader childShader;  // previous pass
uniform shader original;     // untouched input - MUST be declared last

const int TAPS = 8;          // 17 samples per axis, per pass

// Sub-tap jitter. A 17-tap kernel spread over `size` pixels puts its samples
// tens of pixels apart at the wide end of the ladder, and because sharp
// highlights are re-injected at every step, each one lands as 17 discrete
// ghost copies - which is what reads as stepping. Offsetting the whole kernel
// by a fraction of a tap, differently for each pixel, turns those hard copies
// into fine noise that the remaining passes then blur away. Keyed on position
// only, so the pattern is static rather than crawling from frame to frame.
float hash21(float2 p) {
    p = fract(p * float2(127.1, 311.7));
    p += dot(p, p + 34.23);
    return fract(p.x * p.y);
}

// The same grade as pass 1, recomputed from the untouched layer.
float3 highlights(float2 coord) {
    half4 c = original.eval(coord);
    float3 lin = c.a > 0.0 ? float3(c.rgb / c.a) : float3(0.0);
    float bp = srcBlack;
    float wp = max(srcWhite, bp + 0.0001);
    return pow(clamp((lin - bp) / (wp - bp), 0.0, 1e4),
               float3(max(response, 0.0001)));
}

half4 main(float2 fragCoord) {
    // At zero this must be an exact passthrough, so the buffer reaches the
    // combine pass holding the streak alone.
    float ba = clamp(bloomAmount, 0.0, 1.0);
    if (ba <= 0.0) { return childShader.eval(fragCoord); }

    // STEPS NOW GATES THE LADDER. It used to be a pure divisor applied once at
    // the end while all four rungs ran regardless - so Steps 1 summed four
    // widths and divided by one, four times too bright, which clips and shows
    // as banded artefacts around every highlight. A control named for a count
    // that only changes exposure is worse than no control.
    //
    // radiusMul is 0.125, 0.25, 0.5, 1.0 down the ladder, so its log gives the
    // rung number; rungs past Steps copy through untouched and cost nothing.
    float rung = floor(log2(max(radiusMul, 0.001) / 0.125) + 1.5);
    if (rung > max(steps, 1.0)) { return childShader.eval(fragCoord); }

    float r = max(size, 0.0) * radiusMul / max(falloff, 0.0001);
    float2 dir = float2(dirX, dirY);

    float3 sum = float3(0.0);
    float  den = 0.0;

    // +/- half a tap, so the kernel never samples the same lattice twice.
    float jitter = hash21(fragCoord + dir * 17.0) - 0.5;

    // TAPER THE TAP COUNT DOWN THE LADDER. Every rung blurs what the previous
    // one already blurred, so the input to rung 4 is far smoother than the
    // input to rung 1 and needs proportionally fewer samples to represent. The
    // texture fetch is what costs; skipping it is a real saving, and the
    // weights renormalise on whatever is used.
    float tapLimit = float(TAPS) - (rung - 1.0) * 1.5;

    for (int i = -TAPS; i <= TAPS; i++) {
        if (abs(float(i)) > tapLimit) { continue; }
        float f = (float(i) + jitter) / float(TAPS);
        float w = exp(-2.0 * f * f);            // gaussian falloff
        sum += float3(childShader.eval(fragCoord + dir * (f * r)).rgb) * w;
        den += w;
    }

    float3 outRgb = sum / max(den, 0.0001);

    // Feed H back in on the vertical pass, which is what makes the chain sum the
    // whole ladder of widths rather than just blurring once.
    // Normalised HERE rather than once at the end. The combine pass used to
    // divide the whole accumulated result by Steps - which also divided
    // anything else riding in the buffer, so the streak could not be added
    // after the bloom without being scaled by an unrelated control.
    if (addH > 0.5) { outRgb += highlights(fragCoord) * ba / max(steps, 1.0); }

    return half4(half3(clamp(outRgb, 0.0, 64.0)), half(1.0));
}
