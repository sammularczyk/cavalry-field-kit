// GENERATED by src/build.cjs from lightwrapFirst.sksl - do not edit.
// Pass constants baked in so this runs on Cavalry 2.7.2, whose pass
// spec has no `constants` support. Edit the source file instead.
// Lightwrap, pass 1 of 9 - Field Kit
// The first horizontal blur of the stencilled background.
//
// A near-copy of lightwrapBlur.sksl, and it exists for one reason: **pass 0 has
// no `original` input, so a shader that DECLARES `uniform shader original`
// fails to build as pass 0 and silently does nothing** - Cavalry logs
// "Pass 0: buildShader failed" and the rest of the chain runs anyway, so the
// symptom is a missing term rather than an error. Later passes take the
// foreground alpha from `original`; on pass 0 `childShader` IS the foreground,
// so no `original` is needed.
//
// See lightwrapBlur.sksl for the mechanism and for why this is a chain of
// separable blurs rather than a ladder of sparse gathers.
//
// BACKGROUND ALIGNMENT - the thing that made this filter look broken.
// A `shaderData` input does NOT evaluate in world space. A Noise Shader is
// domain-agnostic so it looks fine either way, but an Image Shader evaluates in
// its SOURCE IMAGE's pixel space measured from a corner - so sampling it at
// world coordinates lands near the image's edge and returns almost nothing. The
// wrap was being computed correctly and fed almost-black.
//
// Hence Background Size and Background Scale: they map world space into the
// background's own pixel space.
//     coord = fragCoord * bgScale + bgSize * 0.5
// bgSize centres the image on the world origin; bgScale accounts for the image
// being displayed at a different size to its native resolution (an image shown
// at half its pixel width needs a scale of 2).
//
// IMPORTANT: shaderData inputs bind BEFORE the input image, which is last.

uniform float  size;
uniform float  falloff;
uniform float  aspect;
uniform float  useLuminance;  // bool: restrict the wrap to bright background
uniform float  threshold;
uniform float2 bgSize;
uniform float2 bgScale;

const float dirX = 1.000000;   // baked from the pass constant
const float dirY = 0.000000;   // baked from the pass constant
const float radiusMul = 0.125000;   // baked from the pass constant

uniform float2 resolution;
uniform float2 rectCentre;

uniform shader background;    // shaderData attribute - binds BEFORE the image
uniform shader childShader;   // pass 1 input = the foreground

const int TAPS = 8;

// World space -> the background shader's own coordinate space. See the header.
float2 bgCoord(float2 fragCoord) {
    return fragCoord * float2(max(bgScale.x, 0.0001), max(bgScale.y, 0.0001))
         + bgSize * 0.5;
}

// Background with the foreground stencilled out, so only light from OUTSIDE the
// foreground can wrap inward.
float3 stencilled(float2 coord) {
    half4 bg = background.eval(bgCoord(coord));
    // Guarded divide, NOT a ternary. An unconnected shaderData input is
    // substituted as a constant half4(0), and SkSL constant-folds BOTH arms
    // of a ternary at compile time - so `a > 0 ? rgb / a : rgb` becomes 0/0
    // and the whole shader fails to compile with "division by zero". The
    // guard never runs. max() cannot fold to zero, so it is always safe.
    float3 lin = float3(bg.rgb) / max(float(bg.a), 1e-6);

    half4 fg = childShader.eval(coord);
    lin *= 1.0 - clamp(float(fg.a), 0.0, 1.0);

    if (useLuminance > 0.5) {
        float lum = dot(lin, float3(0.299, 0.587, 0.114));
        lin *= smoothstep(threshold, 1.0, lum);
    }
    return lin;
}

half4 main(float2 fragCoord) {
    float r = max(size, 0.0) * radiusMul / max(falloff, 0.0001);
    // Aspect stretches the horizontal pass only, which is where it belongs.
    float2 dir = float2(dirX * max(aspect, 0.01), dirY);

    float3 sum = float3(0.0);
    float  den = 0.0;

    for (int i = -TAPS; i <= TAPS; i++) {
        float f = float(i) / float(TAPS);
        float w = exp(-2.0 * f * f);
        sum += stencilled(fragCoord + dir * (f * r)) * w;
        den += w;
    }

    return half4(half3(clamp(sum / max(den, 0.0001), 0.0, 64.0)), half(1.0));
}
